//==============================================================
// Direction report: exactly three states
//==============================================================
enum ENUM_OBSERVER_DIRECTION
{
   OBS_DIRECTION_DOWN    = -1,
   OBS_DIRECTION_UNKNOWN =  0,
   OBS_DIRECTION_UP      =  1
};

//==============================================================
// Input point
//
// The input array is ordered newest -> oldest.
// seriesId identifies the source series.
// branchId is assigned by the algorithm.
//==============================================================
struct SObserverPoint
{
   datetime time;
   double   price;

   //int      seriesId;
   //int      branchId;
};

//==============================================================
// Configuration
//==============================================================
struct SBranchConfig
{
   int minWaitingPoints;
   int maxWaitingPoints;
};

//==============================================================
// Internal branch state
//==============================================================
struct SBranchState
{
   int      id;
   bool     active;

   int      pointCount;

   double   previousPrice;
   double   lastPrice;

   int      direction;

   int      lastSeenStep;
};

//==============================================================
// Count active branches
//==============================================================
int CountActiveBranches()
{
   int count;
   return count = ArraySize(branches);
}

//==============================================================
// Determine the direction of a price difference
//==============================================================
int PriceDirection(const double first, const double second)
{
   if(second > first)
      return +1;

   if(second < first)
      return -1;

   return 0;
}

//==============================================================
// Calculate the waiting period from active branch count
//
// N = 2  -> 2 points
// N = 3  -> 2 points
// N = 4  -> 3 points
// N = 5  -> 4 points
// N >= 6 -> 5 points
//
// The limits are configurable.
//==============================================================
int CalculateWaitingPeriod(
   const int activeCount,
   const SBranchConfig &config
)
{
   int waiting = activeCount - 1;

   if(waiting < config.minWaitingPoints)
      waiting = config.minWaitingPoints;

   if(waiting > config.maxWaitingPoints)
      waiting = config.maxWaitingPoints;

   return waiting;
}

//==============================================================
// Can a new point be appended without breaking monotonicity?
//
// A one-point branch has no direction yet.
// Its second point establishes the initial direction.
//
// A branch with a known direction accepts only a point
// that preserves that direction.
// Equal prices are allowed.
//==============================================================
bool CanAppendPoint(
   const SBranchState &branch,
   const double newPrice
)
{
   if(!branch.active)
      return false;

   if(branch.pointCount < 2)
      return true;

   if(branch.direction > 0)
      return (newPrice >= branch.lastPrice);

   if(branch.direction < 0)
      return (newPrice <= branch.lastPrice);

   // A flat branch can establish its direction
   // when a different price arrives.
   return true;
}

//==============================================================
// Append a point to an existing branch
//==============================================================
void AppendPointToBranch(
   SBranchState &branch,
   const double price,
   const int step
)
{
   
   //We know it will remain monotonic
   //
   branch.previousPrice = branch.lastPrice;
   branch.lastPrice     = price;

   if(branch.direction == 0)
   {
      branch.direction = PriceDirection(
         branch.previousPrice,
         branch.lastPrice
      );
   }

   branch.pointCount++;
   branch.lastSeenStep = step;
}

//==============================================================
// Create a new branch containing one point
//==============================================================
int CreateBranch(
   const int branchId,
   const double price,
   const int step
)
{
   int index = ArraySize(branches);

   if(ArrayResize(branches, index + 1) != index + 1)
      return -1;

   branches[index].id            = branchId;
   branches[index].active        = true;

   branches[index].pointCount    = 1;

   branches[index].previousPrice  = price;
   branches[index].lastPrice      = price;

   branches[index].direction      = 0;

   branches[index].lastSeenStep   = step;

   return index;
}

//==============================================================
// Expire branches that received no point within their waiting
// period.
//
// A branch gets its final opportunity when the number of
// subsequent points reaches the waiting period.
//==============================================================
void ExpireInactiveBranches(
   const int step,
   const SBranchConfig &config
)
{
   int i = 0;

   while(i < ArraySize(branches))
   {
      int activeCount = CountActiveBranches();

      int waiting = CalculateWaitingPeriod(
         activeCount,
         config
      );

      int elapsed = step - branches[i].lastSeenStep;

      if(elapsed >= waiting)
      {
         RemoveBranch(i);

         // عضو بعدی به همین اندیس منتقل شده است.
         // بنابراین اندیس را افزایش نمی‌دهیم.
      }
      else
      {
         ++i;
      }
   }
}

//==============================================================
// Convert the report state to text
//==============================================================
string ObserverDirectionText(
   const ENUM_OBSERVER_DIRECTION direction
)
{
   switch(direction)
   {
      case OBS_DIRECTION_UP:
         return "صعودی";

      case OBS_DIRECTION_DOWN:
         return "نزولی";

      default:
         return "نامشخص";
   }
}

//==============================================================
// Print the three-state report
//==============================================================
void PrintDirectionReport(
   const ENUM_OBSERVER_DIRECTION direction
)
{
   Print("جهت: ", ObserverDirectionText(direction));
}



void ProcessNewPoint(
   const SObserverPoint &point,
   const SBranchConfig &config,
   int &nextBranchId,
   int &step,
   ENUM_OBSERVER_DIRECTION &result
)
{
   // Advance the processing step.
   step++;

   bool assigned = false;

   // Find the first branch that accepts the new point.
   for(int i = 0; i < ArraySize(branches); i++)
   {
      if(!CanAppendPoint(branches[i], point.price))
         continue;

      AppendPointToBranch(branches[i], point.price, step);

      assigned = true;
      break;
   }

   // Create a new branch only when no existing branch accepts the point.
   if(!assigned)
   {
      int newBranchIndex = CreateBranch(
         nextBranchId,
         point.price,
         step
      );
      if(newBranchIndex >= 0)
         nextBranchId++;
      else{
         Print("Error: Failed to create a new branch.");
         return;
      }
   }

   // Expire branches according to the configured waiting period.
   ExpireInactiveBranches(step, config);

   // Count the directions of the surviving branches.
   int rising  = 0;
   int falling = 0;

   for(int i = 0; i < ArraySize(branches); i++)
   {
      
      if(branches[i].pointCount < 2)
         continue;

      if(branches[i].direction > 0)
         rising++;
      else if(branches[i].direction < 0)
         falling++;
   }

   // Determine the overall direction.
   if(rising > falling)
      result = OBS_DIRECTION_UP;
   else if(falling > rising)
      result = OBS_DIRECTION_DOWN;
   else
      result = OBS_DIRECTION_UNKNOWN;
}





// حذف فیزیکی شاخه از آرایه
void RemoveBranch( const int index )
{
   int count = ArraySize(branches);

   if(index < 0 || index >= count)
      return;

   for(int i = index; i < count - 1; ++i)
      branches[i] = branches[i + 1];

   ArrayResize(branches, count - 1);
}



SBranchConfig branchConfig;

SBranchState branches[];

int Step = 0;
int BranchID = 0;

datetime e1 = 0;

//+------------------------------------------------------------------+
//| Initialization                                                   |
//+------------------------------------------------------------------+
int OnInit()
{
   branchConfig.minWaitingPoints = 2;
   branchConfig.maxWaitingPoints = 5;

   ArrayResize(branches, 0);

   Step = 0;
   BranchID = 0;
   e1 = 0;

   return INIT_SUCCEEDED;
}

void OnTick()
{  

   if(e1 == iTime(_Symbol,PERIOD_H1,0) ) return;
   e1 = iTime(_Symbol,PERIOD_H1,0);
   
   SObserverPoint point;
   
   point.time  = iTime (_Symbol,PERIOD_H1,1);
   point.price = iClose(_Symbol,PERIOD_H1,1);   
   //point.branchId = -1 ;
   
   

   ENUM_OBSERVER_DIRECTION direction=OBS_DIRECTION_UNKNOWN;
   ProcessNewPoint(point,branchConfig,BranchID,Step,direction); 
   
   PrintDirectionReport(direction);
}




