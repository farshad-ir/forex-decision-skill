void LogRedCarpetState()
{
   Print(
      "[RED CARPET STATE]",
      " | MA Direction: ", redCarpet.MADirection(),
      " | ZigZag Direction: ", redCarpet.ZigZagDirection(),
      " | Overlap Active: ", redCarpet.OverlapActive()
   );

   if(redCarpet.OverlapActive())
   {
      Print(
         "[RED CARPET OVERLAP]",
         " | Start: ", TimeToString(redCarpet.OverlapStart()),
         " | End: ", TimeToString(redCarpet.OverlapEnd()),
         " | High: ", DoubleToString(redCarpet.OverlapHigh(), _Digits),
         " | Low: ", DoubleToString(redCarpet.OverlapLow(), _Digits)
      );
   }
}

void LogRedCarpetEvents()
{
   int count = redCarpet.EventCount();

   while(lastRedCarpetEvent < count)
   {
      RCEvent ev;

      if(!redCarpet.GetEvent(lastRedCarpetEvent, ev))
      {
         lastRedCarpetEvent++;
         continue;
      }

      Print(
         "[RED CARPET EVENT] ",
         ev.name,
         " | Time: ", TimeToString(ev.time),
         " | Detail: ", ev.detail,
         " | Price: ", DoubleToString(ev.price, _Digits),
         " | Direction: ", ev.direction
      );

      lastRedCarpetEvent++;
   }
}            

void LogRedCarpetZigZagResults()
{
   int count = redCarpet.ZigZagResultCount();

   for(int i = 0; i < count; i++)
   {
      RCZigZagResult result;

      if(!redCarpet.GetZigZagResult(i, result))
         continue;

      Print(
         "[RED CARPET ZIGZAG] ",
         result.label,
         " | Box1: ",
         TimeToString(result.box1Start),
         " - ",
         TimeToString(result.box1End),
         " | Box0: ",
         TimeToString(result.box0Start),
         " - ",
         TimeToString(result.box0End),
         " | Points: ",
         ArraySize(result.points),
         " | SSE: ",
         DoubleToString(result.sse, 8),
         " | Imbalance: ",
         DoubleToString(result.imbalance, 8),
         " | High Slope: ",
         DoubleToString(result.highSlopeDeg, 2),
         " | Low Slope: ",
         DoubleToString(result.lowSlopeDeg, 2)
      );

      for(int j = 0; j < ArraySize(result.points); j++)
      {
         RCPathPoint p = result.points[j];

         string pointType = "ENDPOINT";

         if(p.type > 0)
            pointType = "HIGH";
         else if(p.type < 0)
            pointType = "LOW";

         Print(
            "[RED CARPET ZIGZAG POINT] ",
            result.label,
            " | Index: ", j,
            " | Time: ", TimeToString(p.time),
            " | Price: ", DoubleToString(p.price, _Digits),
            " | Type: ", pointType,
            " | Shift: ", p.shift,
            " | Sources: ", p.sources
         );
      }
   }
}


