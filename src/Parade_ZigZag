struct ZigZagResult
{
   PathPoint points[];
   double    error;
   double    balance;
   string    label;
};

ZigZagResult results[];



void StoreResults()
{
   ArrayResize(results, 0);

   if(ArraySize(bestA) >= 2)
   {
      int n = ArraySize(results);
      ArrayResize(results, n + 1);

      ArrayResize(results[n].points, ArraySize(bestA));

      for(int i = 0; i < ArraySize(bestA); i++)
         results[n].points[i] = bestA[i];

      results[n].error  = bestErrorA;
      results[n].balance = bestBalanceA;
      results[n].label  = "BEST";
   }

   if(ArraySize(bestB) >= 2 && bestErrorB < DBL_MAX)
   {
      int n = ArraySize(results);
      ArrayResize(results, n + 1);

      ArrayResize(results[n].points, ArraySize(bestB));

      for(int i = 0; i < ArraySize(bestB); i++)
         results[n].points[i] = bestB[i];

      results[n].error  = bestErrorB;
      results[n].balance = bestBalanceB;
      results[n].label  = "ALTERNATIVE";
   }
}


int OnInit()
{
   if(StartTime<=0||EndTime<=0)
   {Print("Set StartTime to the older time and EndTime to the newer time.");return INIT_PARAMETERS_INCORRECT;}
   StartShift=iBarShift(_Symbol,PERIOD_H1,StartTime,false);
   EndShift=iBarShift(_Symbol,PERIOD_H1,EndTime,false);
   if(StartShift<3||EndShift<2||StartShift<=EndShift||MaxZigZagPoints<0||MaxZigZagPoints>4||
      MatchDistance<0||TrailingAfter<1||AmbiguityTolerancePercent<0.0||MaxCandidatePoints<2)
   {Print("Invalid inputs or unavailable time range.");return INIT_PARAMETERS_INCORRECT;}

   ArraySetAsSeries(rates,true);int required=StartShift+3;
   int copied=CopyRates(_Symbol,PERIOD_H1,0,required,rates);
   if(copied<required){PrintFormat("Not enough H1 bars: required=%d copied=%d",required,copied);return INIT_FAILED;}
   
   RunEngine();
   int count = ArraySize(results);
   for(int i = 0 ; i < count; i++){
      Print("========================");
      Print(results[i].label);
      Print(results[i].balance);
      int pointCount = ArraySize(results[i].points);
      
      for(int j = 0 ; j < pointCount ; j ++){
         Print( results[i].points[j].shift ,": ", results[i].points[j].price);
      }
   }
   return INIT_SUCCEEDED;
}

