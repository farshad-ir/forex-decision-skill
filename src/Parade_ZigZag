//+------------------------------------------------------------------+
//| Parade_ZigZag_Optimized.mq5                                      |
//| Fractal + Parade candidate pool; fit-driven zigzag selection      |
//+------------------------------------------------------------------+
#property strict
#property version   "2.00"
#property description "Parade / Fractal Geometry Engine"

input datetime StartTime = 0;       // older boundary
input datetime EndTime   = 0;       // newer boundary
input int    TrailingAfter = 3;
input int    MatchDistance = 5;      // retained for comparison with v1.10
input int    MaxZigZagPoints = 4;    // intermediate vertices; endpoints are fixed
input double AmbiguityTolerancePercent = 2.0;
input int    MaxCandidatePoints = 80;

#define SRC_FRACTAL  1
#define SRC_PARADE1  2
#define SRC_PARADE2  4
#define SRC_PARADE3  8
#define SRC_PARADE4 16
#define SRC_PARADE5 32

struct PathPoint
{
   int      shift;
   datetime time;
   double   price;
   int      type;       // +1 HIGH, -1 LOW, 0 fixed endpoint
   int      sources;    // bit mask: multiple methods may propose same point
};

MqlRates rates[];
PathPoint fractals[], parade[], candidates[], workPoints[], bestA[], bestB[];
int StartShift=-1, EndShift=-1, candidateLimitHit=0;
double bestErrorA=DBL_MAX, bestErrorB=DBL_MAX;
double bestBalanceA=DBL_MAX, bestBalanceB=DBL_MAX;
long evaluatedPaths=0;

//+------------------------------------------------------------------+
void AddPoint(PathPoint &arr[],const int shift,const double price,
              const int type,const int source)
{
   int n=ArraySize(arr); ArrayResize(arr,n+1);
   arr[n].shift=shift; arr[n].time=rates[shift].time;
   arr[n].price=price; arr[n].type=type; arr[n].sources=source;
}

int CandleDirection(const int shift)
{
   if(rates[shift].close>rates[shift].open) return +1;
   if(rates[shift].close<rates[shift].open) return -1;
   return 0;
}

//+------------------------------------------------------------------+
void MergeCandidate(const PathPoint &p)
{
   if(p.shift>=StartShift || p.shift<=EndShift) return;
   int n=ArraySize(candidates);
   for(int i=0;i<n;i++)
   {
      if(candidates[i].shift!=p.shift || candidates[i].type!=p.type) continue;
      candidates[i].sources|=p.sources;
      if(p.type==+1 && p.price>candidates[i].price) candidates[i].price=p.price;
      if(p.type==-1 && p.price<candidates[i].price) candidates[i].price=p.price;
      return;
   }
   if(n>=MaxCandidatePoints) { candidateLimitHit=1; return; }
   ArrayResize(candidates,n+1); candidates[n]=p;
}

void MergeArray(PathPoint &arr[],const int source)
{
   for(int i=0;i<ArraySize(arr);i++)
   {
      PathPoint p=arr[i]; p.sources|=source; MergeCandidate(p);
   }
}

// Fractal with two bars on each side; equal neighbours require at least
// one strict comparison, matching the original v1.10 behavior.
void BuildFractals()
{
   ArrayResize(fractals,0);
   for(int i=StartShift;i>=EndShift;i--)
   {
      double h=rates[i].high,l=rates[i].low;
      bool fh=true,fl=true,hs=false,ls=false;
      for(int j=1;j<=2;j++)
      {
         if(h<rates[i-j].high || h<rates[i+j].high) fh=false;
         if(h>rates[i-j].high || h>rates[i+j].high) hs=true;
         if(l>rates[i-j].low || l>rates[i+j].low) fl=false;
         if(l<rates[i-j].low || l<rates[i+j].low) ls=true;
      }
      if(fh&&hs) AddPoint(fractals,i,h,+1,SRC_FRACTAL);
      if(fl&&ls) AddPoint(fractals,i,l,-1,SRC_FRACTAL);
   }
}

int FindInitialDirection(int &start)
{
   for(int i=StartShift;i>=EndShift;i--)
   { int d=CandleDirection(i); if(d!=0) { start=i; return d; } }
   return 0;
}

// Method 1 preserved: reverse after three consecutive opposing bodies.
void BuildParade1()
{
   ArrayResize(parade,0); int start; int dir=FindInitialDirection(start); if(dir==0)return;
   int exShift=start,oppCount=0,oppStart=-1;
   double exPrice=(dir==+1?rates[start].high:rates[start].low);
   for(int i=start-1;i>=EndShift;i--)
   {
      int cd=CandleDirection(i);
      if(dir==+1&&rates[i].high>exPrice){exPrice=rates[i].high;exShift=i;}
      if(dir==-1&&rates[i].low<exPrice){exPrice=rates[i].low;exShift=i;}
      if(cd==0)continue;
      if(cd==dir){oppCount=0;oppStart=-1;continue;}
      if(oppCount==0)oppStart=i;
      oppCount++;
      if(oppCount>=3)
      {
         AddPoint(parade,exShift,exPrice,dir,SRC_PARADE1);
         dir=cd; exShift=oppStart;
         exPrice=(dir==+1?rates[oppStart].high:rates[oppStart].low);
         oppCount=0;oppStart=-1;
      }
   }
   AddPoint(parade,exShift,exPrice,dir,SRC_PARADE1);
}

// Method 2 preserved: opposing candle wick crosses the anchor open.
void BuildParade2()
{
   ArrayResize(parade,0); int start; int dir=FindInitialDirection(start); if(dir==0)return;
   int exShift=start; double exPrice=(dir==+1?rates[start].high:rates[start].low);
   double anchor=rates[start].open;
   for(int i=start-1;i>=EndShift;i--)
   {
      int cd=CandleDirection(i);
      if(dir==+1&&rates[i].high>exPrice){exPrice=rates[i].high;exShift=i;}
      if(dir==-1&&rates[i].low<exPrice){exPrice=rates[i].low;exShift=i;}
      if(cd==0||cd==dir)continue;
      bool broken=(dir==+1?rates[i].low<anchor:rates[i].high>anchor);
      if(!broken)continue;
      AddPoint(parade,exShift,exPrice,dir,SRC_PARADE2);
      dir=-dir;anchor=rates[i].open;exShift=i;
      exPrice=(dir==+1?rates[i].high:rates[i].low);
   }
   AddPoint(parade,exShift,exPrice,dir,SRC_PARADE2);
}

// Method 3 preserved exactly in principle: old one-bar-step trailing anchor.
void BuildParade3()
{
   ArrayResize(parade,0); int start; int dir=FindInitialDirection(start); if(dir==0)return;
   int exShift=start,anchorShift=start,favorable=0;
   double exPrice=(dir==+1?rates[start].high:rates[start].low),anchor=rates[start].open;
   int threshold=MathMax(1,TrailingAfter);
   for(int i=start-1;i>=EndShift;i--)
   {
      int cd=CandleDirection(i);
      if(dir==+1&&rates[i].high>exPrice){exPrice=rates[i].high;exShift=i;}
      if(dir==-1&&rates[i].low<exPrice){exPrice=rates[i].low;exShift=i;}
      if(cd==0)continue;
      if(cd==dir)
      {
         favorable++;
         if(favorable>=threshold){anchorShift=MathMax(EndShift,anchorShift-1);anchor=rates[anchorShift].open;favorable=0;}
         continue;
      }
      bool broken=(dir==+1?rates[i].low<anchor:rates[i].high>anchor);
      if(!broken)continue;
      AddPoint(parade,exShift,exPrice,dir,SRC_PARADE3);
      dir=-dir;anchorShift=i;anchor=rates[i].open;favorable=0;exShift=i;
      exPrice=(dir==+1?rates[i].high:rates[i].low);
   }
   AddPoint(parade,exShift,exPrice,dir,SRC_PARADE3);
}

// Method 4 new: like Strict, but only a CLOSE beyond anchor open reverses.
void BuildParade4()
{
   ArrayResize(parade,0); int start; int dir=FindInitialDirection(start); if(dir==0)return;
   int exShift=start; double exPrice=(dir==+1?rates[start].high:rates[start].low);
   double anchor=rates[start].open;
   for(int i=start-1;i>=EndShift;i--)
   {
      int cd=CandleDirection(i);
      if(dir==+1&&rates[i].high>exPrice){exPrice=rates[i].high;exShift=i;}
      if(dir==-1&&rates[i].low<exPrice){exPrice=rates[i].low;exShift=i;}
      if(cd==0||cd==dir)continue;
      bool broken=(dir==+1?rates[i].close<anchor:rates[i].close>anchor);
      if(!broken)continue;
      AddPoint(parade,exShift,exPrice,dir,SRC_PARADE4);
      dir=-dir;anchor=rates[i].open;exShift=i;
      exPrice=(dir==+1?rates[i].high:rates[i].low);
   }
   AddPoint(parade,exShift,exPrice,dir,SRC_PARADE4);
}

// Method 5 new: favorable bodies accumulate despite intervening opposing bodies.
// Each threshold advances the anchor to the next favorable candle in sequence.
void BuildParade5()
{
   ArrayResize(parade,0); int start; int dir=FindInitialDirection(start); if(dir==0)return;
   int exShift=start,anchorShift=start,favorableCount=0,nextAnchor=0;
   double exPrice=(dir==+1?rates[start].high:rates[start].low),anchor=rates[start].open;
   int favorableShifts[]; ArrayResize(favorableShifts,0);
   int threshold=MathMax(1,TrailingAfter);
   for(int i=start-1;i>=EndShift;i--)
   {
      int cd=CandleDirection(i);
      if(dir==+1&&rates[i].high>exPrice){exPrice=rates[i].high;exShift=i;}
      if(dir==-1&&rates[i].low<exPrice){exPrice=rates[i].low;exShift=i;}
      if(cd==0)continue;
      if(cd==dir)
      {
         int n=ArraySize(favorableShifts);ArrayResize(favorableShifts,n+1);favorableShifts[n]=i;
         favorableCount++;
         if(favorableCount>=threshold)
         {
            while(nextAnchor<ArraySize(favorableShifts)&&favorableShifts[nextAnchor]>=anchorShift)nextAnchor++;
            if(nextAnchor<ArraySize(favorableShifts))
            { anchorShift=favorableShifts[nextAnchor];anchor=rates[anchorShift].open;nextAnchor++; }
            favorableCount=0;
         }
         continue;
      }
      bool broken=(dir==+1?rates[i].low<anchor:rates[i].high>anchor);
      if(!broken)continue;
      AddPoint(parade,exShift,exPrice,dir,SRC_PARADE5);
      dir=-dir;anchorShift=i;anchor=rates[i].open;favorableCount=0;
      ArrayResize(favorableShifts,0);nextAnchor=0;exShift=i;
      exPrice=(dir==+1?rates[i].high:rates[i].low);
   }
   AddPoint(parade,exShift,exPrice,dir,SRC_PARADE5);
}

void SortCandidatesOldToNew()
{
   int n=ArraySize(candidates);
   for(int i=0;i<n-1;i++)for(int j=i+1;j<n;j++)
      if(candidates[j].shift>candidates[i].shift)
      {PathPoint t=candidates[i];candidates[i]=candidates[j];candidates[j]=t;}
}

string SourceNames(const int mask)
{
   string s="";
   if((mask&SRC_FRACTAL)!=0)s+="F";
   if((mask&SRC_PARADE1)!=0)s+=(s==""?"P1":"+P1");
   if((mask&SRC_PARADE2)!=0)s+=(s==""?"P2":"+P2");
   if((mask&SRC_PARADE3)!=0)s+=(s==""?"P3":"+P3");
   if((mask&SRC_PARADE4)!=0)s+=(s==""?"P4":"+P4");
   if((mask&SRC_PARADE5)!=0)s+=(s==""?"P5":"+P5");
   return(s==""?"END":s);
}

// Calculate SSE between the polyline and all candle CLOSES in range.
double ComputeFitError(PathPoint &v[])
{
   int n=ArraySize(v);if(n<2)return DBL_MAX;
   double err=0.0;int seg=0;
   for(int sh=StartShift;sh>=EndShift;sh--)
   {
      while(seg<n-2&&sh<v[seg+1].shift)seg++;
      PathPoint a=v[seg],b=v[seg+1];int span=a.shift-b.shift;
      double predicted=b.price;
      if(span>0){double f=(double)(a.shift-sh)/(double)span;predicted=a.price+f*(b.price-a.price);}
      double d=rates[sh].close-predicted;err+=d*d;
   }
   return err;
}

// Secondary metric: variability of price amplitudes of strictly interior legs.
double ComputeInteriorImbalance(PathPoint &v[])
{
   int n=ArraySize(v);if(n<4)return 0.0;
   double prev=MathAbs(v[2].price-v[1].price),sum=0.0;int count=0;
   for(int i=2;i<=n-3;i++){double cur=MathAbs(v[i+1].price-v[i].price);sum+=MathAbs(cur-prev);prev=cur;count++;}
   return(count>0?sum/count:0.0);
}

bool SamePath(PathPoint &a[],PathPoint &b[])
{
   if(ArraySize(a)!=ArraySize(b))return false;
   for(int i=0;i<ArraySize(a);i++)if(a[i].shift!=b[i].shift||a[i].type!=b[i].type)return false;
   return true;
}

void CopyPath(PathPoint &src[],PathPoint &dst[])
{
   ArrayResize(dst,ArraySize(src));for(int i=0;i<ArraySize(src);i++)dst[i]=src[i];
}

void ConsiderCurrentPath()
{
   int d=ArraySize(workPoints);PathPoint full[];ArrayResize(full,d+2);
   full[0].shift=StartShift;full[0].time=rates[StartShift].time;full[0].price=rates[StartShift].open;full[0].type=0;full[0].sources=0;
   for(int i=0;i<d;i++)full[i+1]=workPoints[i];
   full[d+1].shift=EndShift;full[d+1].time=rates[EndShift].time;full[d+1].price=rates[EndShift].close;full[d+1].type=0;full[d+1].sources=0;
   double fit=ComputeFitError(full),bal=ComputeInteriorImbalance(full);evaluatedPaths++;

   if(fit<bestErrorA-1e-12||(MathAbs(fit-bestErrorA)<=1e-12&&bal<bestBalanceA))
   {
      if(ArraySize(bestA)>0&&!SamePath(full,bestA))
      {CopyPath(bestA,bestB);bestErrorB=bestErrorA;bestBalanceB=bestBalanceA;}
      CopyPath(full,bestA);bestErrorA=fit;bestBalanceA=bal;
   }
   else if(!SamePath(full,bestA)&&(fit<bestErrorB-1e-12||(MathAbs(fit-bestErrorB)<=1e-12&&bal<bestBalanceB)))
   {CopyPath(full,bestB);bestErrorB=fit;bestBalanceB=bal;}
}

void SearchSubsets(const int startIndex)
{
   ConsiderCurrentPath();int depth=ArraySize(workPoints);
   if(depth>=MaxZigZagPoints)return;
   int n=ArraySize(candidates);
   for(int i=startIndex;i<n;i++)
   {
      PathPoint p=candidates[i];
      if(depth>0&&(workPoints[depth-1].type==p.type||workPoints[depth-1].shift==p.shift))continue;
      ArrayResize(workPoints,depth+1);workPoints[depth]=p;SearchSubsets(i+1);
   }
   ArrayResize(workPoints,depth);
}

void PrintPath(const string label,PathPoint &path[],const double error,const double balance)
{
   PrintFormat("%s | Close-SSE=%s | InteriorImbalance=%s | IntermediateVertices=%d",
               label,DoubleToString(error,8),DoubleToString(balance,_Digits),MathMax(0,ArraySize(path)-2));
   for(int i=0;i<ArraySize(path);i++)
   {
      string typ="END";if(path[i].type==1)typ="HIGH";if(path[i].type==-1)typ="LOW";
      PrintFormat("  %d | %s | shift=%d | time=%s | price=%s | source=%s",i,typ,path[i].shift,
                  TimeToString(path[i].time,TIME_DATE|TIME_MINUTES),DoubleToString(path[i].price,_Digits),SourceNames(path[i].sources));
   }
}

