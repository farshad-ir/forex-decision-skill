void ReviewGapWithRiver(CFractalGeometry &fractal)
{
   if(m_dyno == NULL)
   {
      Print("[RedCarpet] SKIPPED: Rainbow dynamics not set");
      return;
   }

   int total = fractal.SmallBoxCount();

   if(total < 2)
   {
      Print("[RedCarpet] SKIPPED: fewer than two boxes");
      return;
   }

   FlatZone box0;

   if(!fractal.GetSmallBox(0, box0))
   {
      Print("[RedCarpet] SKIPPED: cannot read box 0");
      return;
   }

   // جلوگیری از پردازش دوباره همان رویداد
   if(box0.startTime == m_lastRedCarpetBoxStart &&
      box0.endTime == m_lastRedCarpetBoxEnd)
      return;

   m_lastRedCarpetBoxStart = box0.startTime;
   m_lastRedCarpetBoxEnd   = box0.endTime;

   if(total > MO_MAX_BOXES)
      total = MO_MAX_BOXES;

   int overlapBoxCount = 1;
   int box1Index = -1;

   FlatZone box;
   FlatZone newestGroupOldestBox = box0;
   FlatZone box1;

   double eps = _Point * 0.5;

   // پیدا کردن گروه باکس‌های هم‌پوشان با باکس صفر
   for(int i = 1; i < total; i++)
   {
      if(!fractal.GetSmallBox(i, box))
         break;

      double commonHigh =
         MathMin(box0.highPrice, box.highPrice);

      double commonLow =
         MathMax(box0.lowPrice, box.lowPrice);

      double overlap = commonHigh - commonLow;

      if(overlap <= eps)
      {
         box1 = box;
         box1Index = i;
         break;
      }

      overlapBoxCount++;
      newestGroupOldestBox = box;
   }

   if(box1Index < 0)
   {
      Print("[RedCarpet] SKIPPED: no older non-overlapping box 1");
      return;
   }

   // فاصله زمانی باید واقعی باشد
   if(box1.endTime >= newestGroupOldestBox.startTime)
   {
      Print(
         "[RedCarpet] SKIPPED: no chronological free gap",
         " Box1End=",
         TimeToString(box1.endTime, TIME_DATE | TIME_MINUTES),
         " GroupStart=",
         TimeToString(
            newestGroupOldestBox.startTime,
            TIME_DATE | TIME_MINUTES
         )
      );

      return;
   }

   int box1EndShift =
      iBarShift(_Symbol, PERIOD_H1, box1.endTime, false);

   int groupStartShift =
      iBarShift(
         _Symbol,
         PERIOD_H1,
         newestGroupOldestBox.startTime,
         false
      );

   int box0EndShift =
      iBarShift(_Symbol, PERIOD_H1, box0.endTime, false);

   if(box1EndShift < 0 ||
      groupStartShift < 0 ||
      box0EndShift < 0)
   {
      Print("[RedCarpet] SKIPPED: invalid H1 shift");
      return;
   }

   // دست‌کم یک کندل کامل آزاد باید وجود داشته باشد.
   if(box1EndShift <= groupStartShift + 1)
   {
      Print(
         "[RedCarpet] SKIPPED: no complete free H1 candle",
         " Box1EndShift=", box1EndShift,
         " GroupStartShift=", groupStartShift
      );

      return;
   }

   Print(
      "[RedCarpet] REVIEW START",
      " Box0Start=",
      TimeToString(box0.startTime, TIME_DATE | TIME_MINUTES),
      " Box0End=",
      TimeToString(box0.endTime, TIME_DATE | TIME_MINUTES),
      " Box1Index=", box1Index,
      " OverlapBoxes=", overlapBoxCount,
      " Box1Start=",
      TimeToString(box1.startTime, TIME_DATE | TIME_MINUTES),
      " Box1End=",
      TimeToString(box1.endTime, TIME_DATE | TIME_MINUTES),
      " Box1High=", DoubleToString(box1.highPrice, _Digits),
      " Box1Low=", DoubleToString(box1.lowPrice, _Digits),
      " Box0OriginShift=", box0EndShift
   );

   if(!m_redCarpetNotebook.Begin(box1, box0.endTime))
      return;

   RiverIsland island = {};
   bool islandActive = false;
   int reviewedCandles = 0;

   // پیمایش کندل‌های آزاد از قدیمی به جدید
   // کندل‌های متعلق به خود باکس‌ها حذف می‌شوند.
   for(int shift = box1EndShift - 1;
       shift > groupStartShift;
       shift--)
   {
      datetime candleTime =
         iTime(_Symbol, PERIOD_H1, shift);

      if(candleTime <= box1.endTime ||
         candleTime >= newestGroupOldestBox.startTime)
         continue;

      double o = iOpen(_Symbol, PERIOD_H1, shift);
      double h = iHigh(_Symbol, PERIOD_H1, shift);
      double l = iLow(_Symbol, PERIOD_H1, shift);
      double c = iClose(_Symbol, PERIOD_H1, shift);

      if(candleTime == 0 ||
         o == 0 ||
         h == 0 ||
         l == 0 ||
         c == 0)
         continue;

      double center = 0.0;
      double widthPips = 0.0;

      RIVER_FAMILY family =
         ClassifyRiverCandle(shift, center, widthPips);

      reviewedCandles++;

      // شیفت نقاط قدیمی‌تر از مبدأ باکس صفر منفی است.
      Print(
         "[RedCarpet] CANDLE",
         " Time=",
         TimeToString(candleTime, TIME_DATE | TIME_MINUTES),
         " ShiftFromBox0=", box0EndShift - shift,
         " Family=", RiverFamilyName(family),
         " O=", DoubleToString(o, _Digits),
         " H=", DoubleToString(h, _Digits),
         " L=", DoubleToString(l, _Digits),
         " C=", DoubleToString(c, _Digits),
         " RiverCenter=", DoubleToString(center, _Digits),
         " RiverWidthPips=", DoubleToString(widthPips, 2),
         " RiverData=",
         (center != 0.0 && widthPips > 0.0)
         ? "VALID"
         : "MISSING"
      );

      // شروع اولین جزیره
      if(!islandActive)
      {
         island.family      = family;
         island.candleCount = 1;

         island.startTime = candleTime;
         island.endTime   = candleTime;

         island.maxHigh     = h;
         island.maxHighTime = candleTime;

         island.minLow     = l;
         island.minLowTime = candleTime;

         islandActive = true;
         continue;
      }

      // تغییر خانواده: پایان جزیره قبلی
      if(family != island.family)
      {
         m_redCarpetNotebook.AddIsland(island);
         PrintRiverIsland(island);

         island.family      = family;
         island.candleCount = 1;

         island.startTime = candleTime;
         island.endTime   = candleTime;

         island.maxHigh     = h;
         island.maxHighTime = candleTime;

         island.minLow     = l;
         island.minLowTime = candleTime;

         continue;
      }

      // ادامه جزیره جاری
      island.candleCount++;
      island.endTime = candleTime;

      if(h > island.maxHigh)
      {
         island.maxHigh     = h;
         island.maxHighTime = candleTime;
      }

      if(l < island.minLow)
      {
         island.minLow     = l;
         island.minLowTime = candleTime;
      }
   }

   // ثبت آخرین جزیره
   if(islandActive)
   {
      m_redCarpetNotebook.AddIsland(island);
      PrintRiverIsland(island);
   }

   m_redCarpetNotebook.Finish(reviewedCandles);

   Print(
      "[RedCarpet] REVIEW FINISHED",
      " ReviewedCandles=", reviewedCandles,
      " SavedRecords=", m_redCarpetNotebook.SavedCount()
   );
}




