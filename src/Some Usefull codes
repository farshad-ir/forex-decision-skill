#ifndef __BOX_HISTORY_REVIEW_MQH__
#define __BOX_HISTORY_REVIEW_MQH__

#include "FractalGeometry.mqh"

#define REVIEW_MAX_BOXES   20

struct ReviewCandle
{
   datetime time;
   double   high;
   double   low;
   double   close;
};

class CBoxHistoryReview
{
private:
   FlatZone    m_boxes[REVIEW_MAX_BOXES];

   int m_boxCount;
   int m_candleCount;
   int idx;

public:
   CBoxHistoryReview()
   {
      m_boxCount    = 0;
      m_candleCount = 0;
   }

   void LoadBoxes(CFractalGeometry &fractal)
   {
      int total = fractal.SmallBoxCount();

      m_boxCount = MathMin(total, REVIEW_MAX_BOXES);

      for(int i = 0; i < m_boxCount; i++)
      {
         fractal.GetSmallBox(i, m_boxes[i]);
      }

      Print("Review boxes loaded: ", m_boxCount);
   }

   void CandleRev()
   {
      int b = m_boxCount - 1 ;
      datetime t0 = m_boxes[b].startTime;
      idx = iBarShift(_Symbol,PERIOD_H1, t0);

      Print("Oldest box start: ",
            TimeToString(t0, TIME_DATE | TIME_MINUTES));

      Print("History starts at shift: ", idx,
         " time: ",
         TimeToString(iTime(_Symbol, PERIOD_H1, idx),
                   TIME_DATE | TIME_MINUTES));      
      
      
   }   

   void Match()
   {
      for(int c = idx; c > 3 ; c--)
      {
         for(int b = m_boxCount - 1 ; b >= 0; b--)
         {
            FlatZone box = m_boxes[b];
            datetime candleTime = iTime(_Symbol, PERIOD_H1, c );
            
            if(  candleTime < box.startTime ||
                 candleTime > box.endTime)
            {
               continue;
            }

            Print(
               "Candle=", TimeToString(candleTime),
               " Box=", TimeToString(
                  box.endTime, TIME_DATE | TIME_MINUTES),
               " H=", DoubleToString(iHigh  (_Symbol, PERIOD_H1, c ), _Digits),
               " L=", DoubleToString(iLow   (_Symbol, PERIOD_H1, c ), _Digits),
               " C=", DoubleToString(iClose (_Symbol, PERIOD_H1, c ), _Digits)
            );
         }
      }
   }
};

#endif







#ifndef __BOX_BREAKOUT_MACHINE_MQH__
#define __BOX_BREAKOUT_MACHINE_MQH__

#include "FractalGeometry.mqh"

enum BOX_EVENT
{
   BOX_EVENT_NONE = 0,
   BOX_EVENT_UPPER_PENETRATION,
   BOX_EVENT_LOWER_PENETRATION,
   BOX_EVENT_UPPER_BREAKOUT,
   BOX_EVENT_LOWER_BREAKOUT,
   BOX_EVENT_CLOSE_INSIDE
};

enum BoxMachineState
{
   BOX_MACHINE_OFF = 0,
   BOX_MACHINE_INSIDE,
   BOX_MACHINE_UPPER_TEST,
   BOX_MACHINE_LOWER_TEST,
   BOX_MACHINE_UPPER_BREAKOUT,
   BOX_MACHINE_LOWER_BREAKOUT
};

class CBoxBreakoutMachine
{
private:
   FlatZone        m_box;
   BoxMachineState m_state;
   bool            m_active;
   datetime        m_lastCandleTime;

public:
   CBoxBreakoutMachine()
   {
      m_state          = BOX_MACHINE_OFF;
      m_active          = false;
      m_lastCandleTime  = 0;
   }

   void Start(FlatZone &box)
   {
      m_box             = box;
      m_state           = BOX_MACHINE_INSIDE;
      m_active          = true;
      m_lastCandleTime  = 0;
   }

   bool IsActive()
   {
      return m_active;
   }

   BoxMachineState State()
   {
      return m_state;
   }

   datetime BoxEndTime()
   {
      return m_box.endTime;
   }

   // فقط رویداد جدید را برمی‌گرداند.
   // shift=1 یعنی آخرین کندل بسته‌شده.
   BOX_EVENT Feed(int shift)
   {
      if(!m_active)
         return BOX_EVENT_NONE;

      datetime t = iTime(_Symbol, PERIOD_CURRENT, shift);

      if(t == 0 || t == m_lastCandleTime)
         return BOX_EVENT_NONE;

      m_lastCandleTime = t;

      double h = iHigh(_Symbol, PERIOD_CURRENT, shift);
      double l = iLow(_Symbol, PERIOD_CURRENT, shift);
      double c = iClose(_Symbol, PERIOD_CURRENT, shift);

      BoxMachineState oldState = m_state;

      // بسته‌شدن بیرون محدوده، بر نفوذ اولویت دارد.
      if(c > m_box.highPrice)
      {
         m_state = BOX_MACHINE_UPPER_BREAKOUT;

         if(oldState != m_state)
            return BOX_EVENT_UPPER_BREAKOUT;

         return BOX_EVENT_NONE;
      }

      if(c < m_box.lowPrice)
      {
         m_state = BOX_MACHINE_LOWER_BREAKOUT;

         if(oldState != m_state)
            return BOX_EVENT_LOWER_BREAKOUT;

         return BOX_EVENT_NONE;
      }

      // قیمت داخل محدوده بسته شده است.
      if(h > m_box.highPrice)
      {
         m_state = BOX_MACHINE_UPPER_TEST;

         if(oldState != m_state)
            return BOX_EVENT_UPPER_PENETRATION;

         return BOX_EVENT_NONE;
      }

      if(l < m_box.lowPrice)
      {
         m_state = BOX_MACHINE_LOWER_TEST;

         if(oldState != m_state)
            return BOX_EVENT_LOWER_PENETRATION;

         return BOX_EVENT_NONE;
      }

      // قیمت کاملاً درون باکس مانده است.
      m_state = BOX_MACHINE_INSIDE;

      if(oldState != BOX_MACHINE_INSIDE)
         return BOX_EVENT_CLOSE_INSIDE;

      return BOX_EVENT_NONE;
   }
};

#endif

















#ifndef __MARKET_NOTEBOOK_MQH__
