   // newCandle و newBoxArrived را فراخواننده تعیین می‌کند.
   //
   void Update(
      CFractalGeometry &fractal,
      bool newCandle,
      bool newBoxArrived
   )
   {
      bool processCandle = false;
   
      datetime t = 0;
      double c = 0.0;
   
      // --------------------------------
      // 1. تشخیص کندل بسته‌شده جدید
      // --------------------------------
      if(newCandle)
      {
         t = iTime(_Symbol, PERIOD_H1, 1);
         c = iClose(_Symbol, PERIOD_H1, 1);
   
         if(t > 0 && c != 0 && t != m_lastCandle)
         {
            m_lastCandle = t;
            processCandle = true;
         }
      }
   
      // --------------------------------
      // 2. بررسی زنجیره قبلی
      // --------------------------------
      if(processCandle)
      {
         bool allowLevelAlerts = true;
         bool finishOverlap    = false;
   
         // اگر زنجیره همپوشانی فعال است،
         // ابتدا با اطلاعات همین زنجیره تصمیم بگیر.
         if(m_zoneReady && m_zoneBoxCount >= 2)
         {
            bool timeExpired = (t > m_zoneEnd);
   
            bool priceOutside =
               (c > m_zoneHigh || c < m_zoneLow);
   
            if(timeExpired && priceOutside)
            {
               finishOverlap = true;
               allowLevelAlerts = true;
            }
            else
            {
               allowLevelAlerts = false;
   
               if(timeExpired &&
                  !priceOutside &&
                  !m_zoneExtended)
               {
                  m_zoneExtended = true;
   
                  Print(
                     "[MarketObserver] OVERLAP EXTENDED: ",
                     "Price remains inside the zone; ",
                     "High=",
                     DoubleToString(m_zoneHigh, _Digits),
                     " Low=",
                     DoubleToString(m_zoneLow, _Digits),
                     " OriginalEnd=",
                     TimeToString(
                        m_zoneEnd,
                        TIME_DATE | TIME_MINUTES
                     ),
                     " Candle=",
                     TimeToString(
                        t,
                        TIME_DATE | TIME_MINUTES
                     )
                  );
               }
            }
   
            // ثبت رویداد بازار با محدوده قدیمی.
            ObserveCandle(t);
   
            // --------------------------------
            // 3. پایان زنجیره همپوشانی
            // --------------------------------
            if(finishOverlap)
            {
               // این اطلاعات باید قبل از پاک‌سازی حفظ شوند.
               int finishedBoxCount = m_zoneBoxCount;
   
               double finishedHigh = m_zoneHigh;
               double finishedLow  = m_zoneLow;
   
               Print(
                  "[MarketObserver] OVERLAP FINISHED: ",
                  "Boxes=",
                  finishedBoxCount,
                  " High=",
                  DoubleToString(finishedHigh, _Digits),
                  " Low=",
                  DoubleToString(finishedLow, _Digits),
                  " End=",
                  TimeToString(
                     m_zoneEnd,
                     TIME_DATE | TIME_MINUTES
                  ),
                  " Candle=",
                  TimeToString(
                     t,
                     TIME_DATE | TIME_MINUTES
                  ),
                  " Close=",
                  DoubleToString(c, _Digits)
               );
   
               // ابتدا وضعیت جهت بعدی را تعیین کن.
               m_pendingDirectionValid = false;
   

               if(finishedBoxCount >= 4)
               {
                  // -----------------------------------------
                  // زنجیره بلند شکسته شده است.
                  // نظریه بعدی همین حالا فعال می‌شود.
                  // -----------------------------------------
               
                  // جهت نظریه مستقیماً از کندل شکست تعیین می‌شود.
                  m_theoryBullish = (c > finishedHigh);
               
                  // محدوده مرجع همان زنجیره شکسته‌شده است.
                  m_theoryReferenceHigh = finishedHigh;
                  m_theoryReferenceLow  = finishedLow;
               
                  // نظریه معلق قبلی دیگر استفاده نمی‌شود.
                  m_suspendedTheoryValid = false;
               
                  // دیگر نیازی به انتظار برای جهت معلق نداریم.
                  m_pendingDirectionValid = false;
               
                  // فعال‌سازی فوری نظریه.
                  m_theoryActive = true;
               
                  // کندل شکست محرک نظریه است، نه شاهد آن.
                  m_theoryStartTime   = t;
                  m_theoryStartCandle = t;
               
                  Print(
                     "[TheoryExperiment] LONG OVERLAP BREAKOUT",
                     "\nBoxes=", finishedBoxCount,
                     "\nNext direction=",
                     m_theoryBullish ? "BULLISH" : "BEARISH"
                  );
               
                  Print(
                     "[TheoryExperiment] THEORY SELECTED",
                     "\nTheory=", RandomTheoryName(),
                     "\nMode=BREAKOUT",
                     "\nTime=",
                     TimeToString(t, TIME_DATE | TIME_MINUTES),
                     "\nReferenceHigh=",
                     DoubleToString(m_theoryReferenceHigh, _Digits),
                     "\nReferenceLow=",
                     DoubleToString(m_theoryReferenceLow, _Digits),
                     "\nEvidence begins after candle=",
                     TimeToString(t, TIME_DATE | TIME_MINUTES)
                  );
               }


               else
               {
                  // زنجیره کوتاه بوده است.
                  // اگر نظریه قبلی ذخیره شده، همان نظریه
                  // با همان محدوده مرجع بازگردانده می‌شود.
                  if(m_suspendedTheoryValid)
                  {
                     Print(
                        "[TheoryExperiment] SHORT OVERLAP",
                        "\nBoxes=", finishedBoxCount,
                        "\nResume=",
                        m_suspendedTheoryBullish
                        ? "RANDOM_BULLISH"
                        : "RANDOM_BEARISH"
                     );
                  }
                  else
                  {
                     Print(
                        "[TheoryExperiment] SHORT OVERLAP",
                        "\nBoxes=", finishedBoxCount,
                        "\nNo suspended theory; ",
                        "random selection remains available."
                     );
                  }
               }
   
               // زنجیره قبلی دیگر مبنای تصمیم‌گیری نیست.
               m_zoneReady    = false;
               m_zoneBoxCount = 0;
               m_zoneExtended = false;
   
               if(m_notebook.SetStuckTheory(false, t))
               {
                  Print(
                     "[MarketObserver] ",
                     "Theory: درجا زدن غیرفعال شد"
                  );
               }
            }
         }
   
         // --------------------------------
         // 4. هشدارهای سطحی
         // --------------------------------
         CheckBoxLevelTouches(
            fractal,
            allowLevelAlerts,
            t
         );
   
         // نظریه فعال، در صورت وجود، ارزیابی می‌شود.
         EvaluateDirectionalTheory(t);
      }
   
      // --------------------------------
      // 5. پردازش باکس جدید
      // --------------------------------
      // مهم: این بخش پس از ارزیابی کندل و زنجیره قبلی اجرا می‌شود.
      if(newBoxArrived){
         CheckNewBox(fractal);
         ReviewGapWithRiver(fractal);
      }
      
         
   }



