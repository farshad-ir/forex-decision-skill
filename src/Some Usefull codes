// ساخت گروه باکس‌هایی که با SmallBox 0 همپوشانی دارند.
// آرایه از جدیدترین به قدیمی‌ترین مرتب شده است.
bool FindGapZone(CFractalGeometry &fractal)
{
   int total = fractal.SmallBoxCount();

   if(total <= 0)
      return false;

   if(total > MO_MAX_BOXES)
      total = MO_MAX_BOXES;

   FlatZone baseBox;
   FlatZone box;

   if(!fractal.GetSmallBox(0, baseBox))
      return false;

   m_zoneHigh     = baseBox.highPrice;
   m_zoneLow      = baseBox.lowPrice;
   m_zoneBoxCount = 1;
   m_zoneStart    = baseBox.startTime;
   m_zoneEnd      = baseBox.endTime;

   double eps = _Point * 0.5;

   FlatZone gapBox;
   


   for(int i = 1; i < total; i++)
   {
      if(!fractal.GetSmallBox(i, box))
         break;

      // همپوشانی قیمتی باکس قدیمی با باکس 0
      double commonHigh =
         MathMin(baseBox.highPrice, box.highPrice);

      double commonLow =
         MathMax(baseBox.lowPrice, box.lowPrice);

      double overlap = commonHigh - commonLow;

      // اولین باکس فاقد همپوشانی؛ پایان جست‌وجو
      if(overlap <= eps)
      {

         gapBox = box;
         
   
         Print(
            "[MarketObserver] FIRST NON-OVERLAPPING BOX",
            " Index=", i,
            " High=", DoubleToString(box.highPrice, _Digits),
            " Low=", DoubleToString(box.lowPrice, _Digits)
         );

         break;
      }

      // این باکس عضو گروه است.
      m_zoneBoxCount++;

      if(box.highPrice > m_zoneHigh)
         m_zoneHigh = box.highPrice;

      if(box.lowPrice < m_zoneLow)
         m_zoneLow = box.lowPrice;

      if(box.startTime < m_zoneStart)
         m_zoneStart = box.startTime;

      if(box.endTime > m_zoneEnd)
         m_zoneEnd = box.endTime;
   }

   m_zoneExtended = false;
   m_zoneReady    = true;

   Print(
      "[MarketObserver] OVERLAP GROUP",
      " Boxes=", m_zoneBoxCount,
      " High=", DoubleToString(m_zoneHigh, _Digits),
      " Low=", DoubleToString(m_zoneLow, _Digits),
      " Start=", TimeToString(m_zoneStart, TIME_DATE | TIME_MINUTES),
      " End=", TimeToString(m_zoneEnd, TIME_DATE | TIME_MINUTES)
   );

   return true;
}


string RiverFamilyName(RIVER_FAMILY family)
{
   if(family == RIVER_FAMILY_BELOW)
      return "BELOW_RIVER";

   if(family == RIVER_FAMILY_ABOVE)
      return "ABOVE_RIVER";

   return "STREET_FIGHT";
}


RIVER_FAMILY ClassifyRiverCandle(
   int shift,
   double &center,
   double &widthPips
)
{
   center    = m_dyno.RainbowCenter(shift);
   widthPips = m_dyno.RainbowWidth(shift);

   double o = iOpen(_Symbol, PERIOD_H1, shift);
   double c = iClose(_Symbol, PERIOD_H1, shift);

   // اگر داده رودخانه موجود نباشد، کندل از افراز جا نمی‌ماند.
   // موقتاً آن را در خانواده مبارزات قرار می‌دهیم.
   if(center == 0.0 || widthPips <= 0.0)
      return RIVER_STREET_FIGHT;

   double pipSize =
      ((_Digits == 3 || _Digits == 5)
       ? 10.0 * _Point
       : _Point);

   double halfWidth = MathAbs(widthPips) * pipSize / 2.0;

   double riverUpper = center + halfWidth;
   double riverLower = center - halfWidth;

   double bodyHigh = MathMax(o, c);
   double bodyLow  = MathMin(o, c);
   double bodySize = bodyHigh - bodyLow;

   // برای کندل بدون بدنه، موقعیت Close ملاک است.
   if(bodySize <= _Point * 0.1)
   {
      if(c > riverUpper)
         return RIVER_FAMILY_ABOVE;

      if(c < riverLower)
         return RIVER_FAMILY_BELOW;

      return RIVER_STREET_FIGHT;
   }

   // طول بدنه‌ای که بالاتر از رودخانه قرار دارد
   double aboveLength =
      MathMax(
         0.0,
         bodyHigh - MathMax(bodyLow, riverUpper)
      );

   // طول بدنه‌ای که پایین‌تر از رودخانه قرار دارد
   double belowLength =
      MathMax(
         0.0,
         MathMin(bodyHigh, riverLower) - bodyLow
      );

   // افراز شل: سمت غالب بدنه تعیین‌کننده است.
   if(aboveLength > belowLength)
      return RIVER_FAMILY_ABOVE;

   if(belowLength > aboveLength)
      return RIVER_FAMILY_BELOW;

   return RIVER_STREET_FIGHT;
}


