void ReviewGapWithRiver(CFractalGeometry &fractal)
{
   if(m_dyno == NULL)
   {
      Print("[RedCarpet] SKIPPED: Rainbow dynamics not set");
      return;
   }

   int total = fractal.SmallBoxCount();

   if(total < 2)
   {
      Print("[RedCarpet] SKIPPED: fewer than two boxes");
      return;
   }

   FlatZone box0, box1;

   fractal.GetSmallBox(0, box0);
   fractal.GetSmallBox(1, box1);

   int oneHour = 60 * 60;

   // اگر بین دو باکس کندل مستقلی وجود ندارد، بررسی نکن.
   if(box1.endTime + oneHour >= box0.startTime)
      return;

   int box1EndShift =
      iBarShift(_Symbol, PERIOD_H1, box1.endTime, false);

   int box0EndShift =
      iBarShift(_Symbol, PERIOD_H1, box0.endTime, false);

   int box0StartShift =
      iBarShift(_Symbol, PERIOD_H1, box0.startTime, false);

   if(box1EndShift < 0 ||
      box0StartShift < 0 ||
      box0EndShift < 0)
   {
      Print("[RedCarpet] SKIPPED: invalid H1 shift");
      return;
   }

   ArraySetAsSeries(rates,true);
   
   StartShift = box1EndShift;
   EndShift   = box0StartShift;
   
   int required = StartShift+3;
   
   int copied=CopyRates(_Symbol,PERIOD_H1,0,required,rates);
   
   if(copied<required)
   {
      PrintFormat("Not enough H1 bars: required=%d copied=%d",required,copied);
      return;
   }
   
   RunEngine();

   Print( "[RedCarpet] REVIEW STARTED" );

   int count = ArraySize(results);
   for(int i = 0 ; i < count; i++){
      Print("========================");
      Print(results[i].label);
      Print(results[i].balance);
      int pointCount = ArraySize(results[i].points);
      
      for(int j = 0 ; j < pointCount ; j ++){
         Print( results[i].points[j].shift ,": ", results[i].points[j].price);
      }
   }








   Print( "[RedCarpet] REVIEW FINISHED" );
}


