#ifndef __BOX_RELATION_REVIEW_MQH__
#define __BOX_RELATION_REVIEW_MQH__

#include "FractalGeometry.mqh"

enum BOX_RELATION
{
   BOX_ABOVE,
   BOX_BELOW,
   BOX_EQUAL,
   BOX_OVERLAP,
   BOX_NEW_INSIDE_OLD,
   BOX_NEW_CONTAINS_OLD,
   BOX_TOUCH
};

class CBoxRelationReview
{
private:
   double Epsilon()
   {
      return _Point * 0.5;
   }

public:
   // newer = باکس جدیدتر
   // older = باکس قدیمی‌تر
   BOX_RELATION Compare(
      FlatZone &newer,
      FlatZone &older,
      double &overlap,
      double &overlapPercent
   )
   {
      double eps = Epsilon();

      double nh = newer.highPrice;
      double nl = newer.lowPrice;
      double oh = older.highPrice;
      double ol = older.lowPrice;

      double commonHigh = MathMin(nh, oh);
      double commonLow  = MathMax(nl, ol);

      overlap = MathMax(0.0, commonHigh - commonLow);

      double newRange = nh - nl;
      double oldRange = oh - ol;
      double minRange = MathMin(newRange, oldRange);

      overlapPercent = 0.0;

      if(minRange > eps && overlap > eps)
         overlapPercent = 100.0 * overlap / minRange;

      if(MathAbs(nh - oh) <= eps &&
         MathAbs(nl - ol) <= eps)
         return BOX_EQUAL;

      if(nl > oh + eps)
         return BOX_ABOVE;

      if(nh < ol - eps)
         return BOX_BELOW;

      if(MathAbs(nl - oh) <= eps ||
         MathAbs(nh - ol) <= eps)
         return BOX_TOUCH;

      if(nh <= oh + eps && nl >= ol - eps)
         return BOX_NEW_INSIDE_OLD;

      if(nh >= oh - eps && nl <= ol + eps)
         return BOX_NEW_CONTAINS_OLD;

      return BOX_OVERLAP;
   }

   string Name(BOX_RELATION relation)
   {
      switch(relation)
      {
         case BOX_ABOVE:           return "ABOVE";
         case BOX_BELOW:           return "BELOW";
         case BOX_EQUAL:           return "EQUAL";
         case BOX_OVERLAP:         return "OVERLAP";
         case BOX_NEW_INSIDE_OLD:  return "NEW_INSIDE_OLD";
         case BOX_NEW_CONTAINS_OLD:return "NEW_CONTAINS_OLD";
         case BOX_TOUCH:           return "TOUCH";
      }

      return "UNKNOWN";
   }
};

#endif







enum RIVER_FAMILY
{
