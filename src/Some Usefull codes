};


#define RED_CARPET_CAPACITY    64
#define RED_CARPET_MAX_POINTS 512

struct RiverZigzagPoint
{
   int    shift;
   double price;
   bool   isHigh;
};

class CRedCarpetNotebook
{
private:
   FlatZone         m_box1[RED_CARPET_CAPACITY];
   RiverZigzagPoint m_points[RED_CARPET_CAPACITY][RED_CARPET_MAX_POINTS];
   int              m_pointCount[RED_CARPET_CAPACITY];
   CMarketObserver  m_observer;

   int m_nextSlot;
   int m_savedCount;
   int m_currentSlot;
   int m_originShift;

   void AddPoint(datetime pointTime, double price, bool isHigh)
   {
      if(m_currentSlot < 0)
         return;

      int count = m_pointCount[m_currentSlot];

      if(count >= RED_CARPET_MAX_POINTS)
      {
         Print("[RedCarpet] POINT CAPACITY REACHED");
         return;
      }

      int pointShift =
         iBarShift(_Symbol, PERIOD_H1, pointTime, false);

      if(pointShift < 0 || m_originShift < 0)
      {
         Print("[RedCarpet] POINT SHIFT FAILED");
         return;
      }

      // مبدأ: endTime باکس 0
      // نقاط قدیمی‌تر از مبدأ باید شیفت منفی داشته باشند.
      int relativeShift = m_originShift - pointShift;

      if(relativeShift > 0)
      {
         Print("[RedCarpet] ERROR: point newer than box-0 origin");
         return;
      }

      m_points[m_currentSlot][count].shift  = relativeShift;
      m_points[m_currentSlot][count].price  = price;
      m_points[m_currentSlot][count].isHigh = isHigh;

      m_pointCount[m_currentSlot]++;

      Print(
         "[RedCarpet] ZIGZAG POINT",
         " Index=", count,
         " Shift=", relativeShift,
         " Price=", DoubleToString(price, _Digits),
         " Flag=", isHigh ? "HIGH" : "LOW"
      );
   }

public:
   CRedCarpetNotebook()
   {
      m_nextSlot    = 0;
      m_savedCount  = 0;
      m_currentSlot = -1;
      m_originShift = -1;

      for(int i = 0; i < RED_CARPET_CAPACITY; i++)
         m_pointCount[i] = 0;
   }

   bool Begin(FlatZone &box1, datetime box0EndTime)
   {
      m_originShift =
         iBarShift(_Symbol, PERIOD_H1, box0EndTime, false);

      if(m_originShift < 0)
      {
         Print("[RedCarpet] BEGIN FAILED: invalid box-0 endTime");
         m_currentSlot = -1;
         return false;
      }

      m_currentSlot = m_nextSlot;
      m_box1[m_currentSlot] = box1;
      m_pointCount[m_currentSlot] = 0;

      Print(
         "[RedCarpet] BEGIN",
         " Box1Start=",
         TimeToString(box1.startTime, TIME_DATE | TIME_MINUTES),
         " Box1End=",
         TimeToString(box1.endTime, TIME_DATE | TIME_MINUTES),
         " Box1High=", DoubleToString(box1.highPrice, _Digits),
         " Box1Low=", DoubleToString(box1.lowPrice, _Digits),
         " Box0Origin=",
         TimeToString(box0EndTime, TIME_DATE | TIME_MINUTES),
         " OriginShift=", m_originShift
      );

      return true;
   }

   void AddIsland(RiverIsland &island)
   {
      if(m_currentSlot < 0)
         return;

      Print(
         "[RedCarpet] ISLAND",
         " Family=", RiverFamilyName(island.family),
         " High=", DoubleToString(island.maxHigh, _Digits),
         " HighTime=",
         TimeToString(island.maxHighTime, TIME_DATE | TIME_MINUTES),
         " Low=", DoubleToString(island.minLow, _Digits),
         " LowTime=",
         TimeToString(island.minLowTime, TIME_DATE | TIME_MINUTES),
         " Candles=", island.candleCount
      );

      // ثبت دو اکسترمم جزیره به ترتیب زمانی
      if(island.maxHighTime < island.minLowTime)
      {
         AddPoint(island.maxHighTime, island.maxHigh, true);
         AddPoint(island.minLowTime, island.minLow, false);
      }
      else if(island.minLowTime < island.maxHighTime)
      {
         AddPoint(island.minLowTime, island.minLow, false);
         AddPoint(island.maxHighTime, island.maxHigh, true);
      }
      else
      {
         // ترتیب درون کندل از OHLC قابل تشخیص نیست.
         Print(
            "[RedCarpet] NOTE: High and Low occurred in the same candle"
         );

         AddPoint(island.maxHighTime, island.maxHigh, true);
         AddPoint(island.minLowTime, island.minLow, false);
      }
   }

   void Finish(int reviewedCandles)
   {
      if(m_currentSlot < 0)
         return;

      int slot  = m_currentSlot;
      int count = m_pointCount[slot];

      if(reviewedCandles <= 0 || count <= 0)
      {
         Print(
            "[RedCarpet] NOT SAVED",
            " Candles=", reviewedCandles,
            " Points=", count
         );

         m_currentSlot = -1;
         m_originShift = -1;
         return;
      }

      Print(
         "[RedCarpet] SAVED",
         " Box1Start=",
         TimeToString(m_box1[slot].startTime, TIME_DATE | TIME_MINUTES),
         " Box1End=",
         TimeToString(m_box1[slot].endTime, TIME_DATE | TIME_MINUTES),
         " Box1High=", DoubleToString(m_box1[slot].highPrice, _Digits),
         " Box1Low=", DoubleToString(m_box1[slot].lowPrice, _Digits),
         " ReviewedCandles=", reviewedCandles,
         " ZigzagPoints=", count
      );

      m_nextSlot = (m_nextSlot + 1) % RED_CARPET_CAPACITY;

      if(m_savedCount < RED_CARPET_CAPACITY)
         m_savedCount++;

      m_currentSlot = -1;
      m_originShift = -1;
   }

   int SavedCount()
   {
      return m_savedCount;
   }

   bool GetRecord(int ageIndex, FlatZone &box1, int &pointCount)
   {
      if(ageIndex < 0 || ageIndex >= m_savedCount)
         return false;

      int slot =
         (m_nextSlot - 1 - ageIndex + RED_CARPET_CAPACITY)
         % RED_CARPET_CAPACITY;

      box1 = m_box1[slot];
      pointCount = m_pointCount[slot];

      return true;
   }

   bool GetPoint(
      int ageIndex,
      int pointIndex,
      RiverZigzagPoint &point
   )
   {
      if(ageIndex < 0 || ageIndex >= m_savedCount)
         return false;

      int slot =
         (m_nextSlot - 1 - ageIndex + RED_CARPET_CAPACITY)
         % RED_CARPET_CAPACITY;

      if(pointIndex < 0 || pointIndex >= m_pointCount[slot])
         return false;

      point.shift =
         m_points[slot][pointIndex].shift;

      point.price =
         m_points[slot][pointIndex].price;

      point.isHigh =
         m_points[slot][pointIndex].isHigh;

      return true;
   }
};



#ifndef __MARKET_OBSERVER_MQH__
