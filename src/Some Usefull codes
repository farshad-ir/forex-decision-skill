
#ifndef __REDCARPET_NOTEBOOK_MQH__
#define __REDCARPET_NOTEBOOK_MQH__

enum MARKET_VIEW
{
   MARKET_FROM_FLOOR   = -2,
   MARKET_BEARISH      = -1,
   MARKET_BULLISH      =  1,
   MARKET_FROM_CEILING =  2,
   MARKET_STUCK        = 0
};

class CMarketNotebook
{
private:
   MARKET_VIEW m_view;
   bool        m_hasView;
   bool        m_stuckTheory;

   string      m_reason;
   string      m_uncertainty;
   datetime    m_eventTime;
   datetime    m_theoryChangeTime;
   
public:
   CMarketNotebook()
   {
      m_view        = MARKET_BULLISH;
      m_hasView     = false;
      m_stuckTheory = false;

      m_reason      = "هنوز رویدادی ثبت نشده است";
      m_uncertainty = "جهت حرکت هنوز مشخص نشده است";
      
      m_eventTime         =  0 ;
      m_theoryChangeTime  =  0 ;
   }

   void Revise(
      MARKET_VIEW view,
      string reason,
      string uncertainty,
      datetime when
   )
   {
      m_view        = view;
      m_hasView     = true;
      m_reason      = reason;
      m_uncertainty = uncertainty;
      m_eventTime   = when;
   }

   // نظریه مستقل از چهار وضعیت رویدادی است.
   bool SetStuckTheory(bool active, datetime when)
   {
      if(m_stuckTheory == active)
         return false;

      m_stuckTheory      = active;
      m_theoryChangeTime = when;

      return true;
   }

   MARKET_VIEW View()
   {
      return m_view;
   }

   bool HasView()
   {
      return m_hasView;
   }

   bool StuckTheory()
   {
      return m_stuckTheory;
   }

   string Reason()
   {
      return m_reason;
   }

   string Uncertainty()
   {
      return m_uncertainty;
   }

   datetime UpdatedAt()
   {
      return m_eventTime;
   }

   string Summary()
   {
      string state = "هنوز رویدادی ثبت نشده است";

      if(m_hasView)
      {
         if(m_view == MARKET_BULLISH)
            state = "به سمت بالا می‌رویم";
         else if(m_view == MARKET_BEARISH)
            state = "به سمت پایین می‌رویم";
         else if(m_view == MARKET_FROM_CEILING)
            state = "از سقف برگشتیم";
         else if(m_view == MARKET_FROM_FLOOR)
            state = "از کف برگشتیم";
      }

      string theory = "نظریه درجا زدن فعال نیست";

      if(m_stuckTheory)
         theory = "نظریه: درجا می‌زنیم";

      string result = "رویداد بازار: " + state
         + "\n" + theory
         + "\nدلیل: " + m_reason
         + "\nعامل تردید: " + m_uncertainty;
      
      if(m_hasView)
      {
         result += "\nزمان رویداد: "
                + TimeToString(m_eventTime, TIME_DATE | TIME_MINUTES);
      }
      else
      {
         result += "\nزمان رویداد: هنوز رویدادی ثبت نشده است";
      }
      
      if(m_theoryChangeTime > 0)
      {
         result += "\nزمان تغییر نظریه: "
                + TimeToString(m_theoryChangeTime, TIME_DATE | TIME_MINUTES);
      }
      else
      {
         result += "\nزمان تغییر نظریه: هنوز تغییری ثبت نشده است";
      }

      return result;

   }
};

#endif



















#ifndef __MARKET_OBSERVER_MQH__
#define __MARKET_OBSERVER_MQH__

#include "FractalGeometry.mqh"
#include "../MA_INERTIA/RainBowDynamics.mqh"

#define MO_MAX_BOXES 1000

struct MOLevelAlertState
{
   datetime boxStart;
   bool     highAlerted;
   bool     lowAlerted;
};


class CMarketObserver
{
private:
   CMarketNotebook m_notebook;

   double   m_zoneHigh;
   double   m_zoneLow;
   int      m_zoneBoxCount;
   datetime m_zoneStart;
   datetime m_zoneEnd;
   bool     m_zoneExtended;

   bool     m_zoneReady;
   datetime m_lastCandle;
   datetime m_lastBoxStart;
   datetime m_lastBoxEnd;

   double   m_lastClose;
   bool     m_hasLastClose;
   string   m_lastRiverOpinion;

   MOLevelAlertState m_levelAlertStates[MO_MAX_BOXES];

   int m_levelAlertCount;
   int m_nextLevelAlertSlot;

   double m_lastAcceptedTouchPrice;
   bool   m_hasAcceptedTouchPrice;
   
  

   datetime m_lastRedCarpetBoxStart;
   datetime m_lastRedCarpetBoxEnd;

   // ------------------------------
   // Random Theory Experiment
   // ------------------------------
   bool     m_theoryActive;
   bool     m_theoryBullish;
   bool     m_randomSeeded;
   int      m_theoryAlertLevel;
   
   datetime m_theoryStartTime;
   datetime m_theoryStartCandle;
   
   double   m_theoryReferenceHigh;
   double   m_theoryReferenceLow;

   // ------------------------------
   // Suspended Theory
   // ------------------------------
   bool   m_suspendedTheoryValid;
   bool   m_suspendedTheoryBullish;
   
   double m_suspendedReferenceHigh;
   double m_suspendedReferenceLow;
   
   // ------------------------------
   // Pending Breakout Direction
   // ------------------------------
   bool m_pendingDirectionValid;
   bool m_pendingDirectionBullish;

   // نام دقیق نظریهٔ فعال
   string RandomTheoryName()
   {
      if(m_theoryBullish)
         return "RANDOM_BULLISH";
   
      return "RANDOM_BEARISH";
   }
public:
   void ConsultRiver()
   {
      double r1 = m_dyno.RainbowCenter(1); // جدیدترین نقطه
      double r2 = m_dyno.RainbowCenter(2); // نقطه قبلی
      double r3 = m_dyno.RainbowCenter(3); // نقطه قدیمی‌تر
   
      string opinion = "RIVER_UNCLEAR";
   
      if(r1 > r2 && r2 > r3)
         opinion = "RIVER_RISING";
      else if(r1 < r2 && r2 < r3)
         opinion = "RIVER_FALLING";
   
      if(opinion != m_lastRiverOpinion)
      {
         Print("River Consultant: ", opinion);
         m_lastRiverOpinion = opinion;
      }

   }
private:
   
   // انتخاب نظریه بر اساس اولویت:
   // 1. جهت شکست زنجیره طولانی
   // 2. بازگرداندن نظریه معلق
   // 3. انتخاب تصادفی
   
   void SelectRandomTheory(datetime when)
   {
   
   
      bool breakoutTheory = false;
      
      // هنگام درجا زدن، نظریه جهت‌دار فعال نمی‌شود.
      if(m_notebook.StuckTheory())
         return;
   
      // نظریه فعال دیگری نساز.
      if(m_theoryActive)
         return;
   
      // برای انتخاب نظریه باید محدوده معتبر باشد.
      if(!m_zoneReady)
         return;
   
      bool resumedTheory = false;
   
      // --------------------------------
      // حالت اول: شکست زنجیره طولانی
      // --------------------------------
      if(m_pendingDirectionValid)
      {
         m_theoryBullish = m_pendingDirectionBullish;
   
         // نظریه جدید، محدوده گروه جدید را مرجع می‌گیرد.
         m_theoryReferenceHigh = m_zoneHigh;
         m_theoryReferenceLow  = m_zoneLow;
         
         breakoutTheory = true ;
         
         m_pendingDirectionValid = false;
   
         // نظریه معلق قبلی دیگر لازم نیست.
         m_suspendedTheoryValid = false;
      }
   
      // --------------------------------
      // حالت دوم: بازگرداندن نظریه قبلی
      // --------------------------------
      else if(m_suspendedTheoryValid)
      {
         m_theoryBullish = m_suspendedTheoryBullish;
   
         // مرجع نظریه قبلی باید حفظ شود.
         m_theoryReferenceHigh = m_suspendedReferenceHigh;
         m_theoryReferenceLow  = m_suspendedReferenceLow;
   
         m_suspendedTheoryValid = false;
   
         resumedTheory = true;
      }
   
      // --------------------------------
      // حالت سوم: انتخاب تصادفی
      // --------------------------------
      else
      {
         m_theoryBullish = ((MathRand() % 2) == 0);
   
         m_theoryReferenceHigh = m_zoneHigh;
         m_theoryReferenceLow  = m_zoneLow;
      }
   
      m_theoryActive = true;
      
      m_theoryAlertLevel = 0 ;
      
      m_theoryStartTime = when;
   
      // آخرین کندل بسته‌شده در لحظه انتخاب.
      // این کندل شاهد نظریه جدید نیست.
      m_theoryStartCandle =
         iTime(_Symbol, PERIOD_H1, 1);
   
      if(m_theoryStartCandle == 0)
         m_theoryStartCandle = when;
   
      Print(
         "[TheoryExperiment] THEORY SELECTED",
         "\nTheory=", RandomTheoryName(),
         "\nMode=",
         resumedTheory ? "RESUMED" :
         (breakoutTheory ? "BREAKOUT" : "RANDOM"),
         "\nTime=",
         TimeToString(when, TIME_DATE | TIME_MINUTES),
         "\nReferenceHigh=",
         DoubleToString(m_theoryReferenceHigh, _Digits),
         "\nReferenceLow=",
         DoubleToString(m_theoryReferenceLow, _Digits),
         "\nEvidence begins after candle=",
         TimeToString(
            m_theoryStartCandle,
            TIME_DATE | TIME_MINUTES
         )
      );
   }
  
   // پایان نظریه بدون حذف شواهد ثبت‌شده در لاگ
   void ExpireRandomTheory(
      string reason,
      datetime when
   )
   {
      if(!m_theoryActive)
         return;
   
      Print(
         "[TheoryExperiment] THEORY EXPIRED",
         "\nReason=", reason,
         "\nTheory=", RandomTheoryName(),
         "\nTime=",
         TimeToString(when, TIME_DATE | TIME_MINUTES)
      );
   
      m_theoryActive = false;
   }
   
   
   // ارزیابی یک کندل بسته‌شده در برابر نظریهٔ فعال
   void EvaluateDirectionalTheory(datetime candleTime)
   {
      if(!m_theoryActive)
         return;
   
      // کندل محرک انتخاب نظریه، شاهد محسوب نمی‌شود.
      if(candleTime <= m_theoryStartCandle)
         return;
   
      double c = iClose(_Symbol, PERIOD_H1, 1);
   
      if(c == 0)
         return;
         
      double referenceHeight =
         m_theoryReferenceHigh - m_theoryReferenceLow;
      
      if(referenceHeight <= 0)
         return;
      
      double contradictionDistance = 0.0;
      
      if(m_theoryBullish && c < m_theoryReferenceLow)
      {
         contradictionDistance =
            m_theoryReferenceLow - c;
      }
      else if(!m_theoryBullish && c > m_theoryReferenceHigh)
      {
         contradictionDistance =
            c - m_theoryReferenceHigh;
      }
      
      double contradictionPercent =
         100.0 * contradictionDistance / referenceHeight;
         
      
   
      string assessment = "INCONCLUSIVE";
      string reason = "Close inside reference zone";
   
      if(m_theoryBullish)
      {
         if(c > m_theoryReferenceHigh)
         {
            assessment = "SUPPORT";
            reason = "Close above reference high";
         }
         else if(c < m_theoryReferenceLow)
         {
            assessment = "CONTRADICTION";
            reason = "Close below reference low";
            
         }
      }
      else
      {
         if(c < m_theoryReferenceLow)
         {
            assessment = "SUPPORT";
            reason = "Close below reference low";
         }
         else if(c > m_theoryReferenceHigh)
         {
            assessment = "CONTRADICTION";
            reason = "Close above reference high";
       
         }
      }


      if(assessment == "CONTRADICTION")
      {
         int observedLevel = 0;
      
         if(contradictionPercent >= 80.0)
            observedLevel = 3;
         else if(contradictionPercent >= 30.0)
            observedLevel = 2;
         else if(contradictionPercent >= 5.0)
            observedLevel = 1;
      
         if(observedLevel > m_theoryAlertLevel)
            m_theoryAlertLevel = observedLevel;
      }


   
      Print(
         "[TheoryExperiment] EVIDENCE",
         "\nTheory=", RandomTheoryName(),
         "\nAssessment=", assessment,
         "\nReason=", reason,
         "\nAlertLevel=", m_theoryAlertLevel,
         "\nContradictionPercent=",
                  DoubleToString(contradictionPercent, 2),
         "\nCandle=",
         TimeToString(candleTime, TIME_DATE | TIME_MINUTES),
         "\nClose=", DoubleToString(c, _Digits)
      );
   }


   // ساخت محدوده مشترک باکس‌های متصل از نظر زمانی
   bool BuildOverLapZone(CFractalGeometry &fractal)
   {
      int total = fractal.SmallBoxCount();

      if(total <= 0)
         return false;

      if(total > MO_MAX_BOXES)
         total = MO_MAX_BOXES;

      FlatZone box;

      // گروه با جدیدترین باکس آغاز می‌شود.
      if(!fractal.GetSmallBox(0, box))
         return false;

      m_zoneHigh     = box.highPrice;
      m_zoneLow      = box.lowPrice;
      m_zoneBoxCount = 1;
      m_zoneStart    = box.startTime;
      m_zoneEnd      = box.endTime;

      datetime groupStart = box.startTime;

      // باکس‌ها از جدیدترین به قدیمی‌ترین مرتب شده‌اند.
      for(int i = 1; i < total; i++)
      {
         if(!fractal.GetSmallBox(i, box))
            break;

         // پایان باکس قدیمی‌تر باید حداکثر یک کندل
         // با شروع گروه فاصله داشته باشد.
         if(box.endTime <
            groupStart - PeriodSeconds(PERIOD_H1))
         {
            break;
         }

         // این باکس به گروه زمانی متصل است.
         groupStart = box.startTime;

         m_zoneBoxCount++;

         if(box.startTime < m_zoneStart)
            m_zoneStart = box.startTime;

         if(box.endTime > m_zoneEnd)
            m_zoneEnd = box.endTime;

         // قیمت فقط برای محاسبه سقف و کف گروه استفاده می‌شود.
         if(box.highPrice > m_zoneHigh)
            m_zoneHigh = box.highPrice;

         if(box.lowPrice < m_zoneLow)
            m_zoneLow = box.lowPrice;
      }

      m_zoneExtended = false;
      m_zoneReady = true;
      
      return true;
   }

// یافتن وضعیت هشدار باکس؛ هر باکس با زمان شروع شناسایی می‌شود.
int FindOrCreateLevelAlertState(datetime boxStart){
   for(int i = 0; i < m_levelAlertCount; i++)
   {
      if(m_levelAlertStates[i].boxStart == boxStart)
         return i;
   }

   int idx;

   if(m_levelAlertCount < MO_MAX_BOXES)
   {
      idx = m_levelAlertCount;
      m_levelAlertCount++;
   }
   else
   {
      // اگر ظرفیت پر شد، قدیمی‌ترین رکوردهای چرخشی جایگزین می‌شوند.
      idx = m_nextLevelAlertSlot;

      m_nextLevelAlertSlot++;

      if(m_nextLevelAlertSlot >= MO_MAX_BOXES)
         m_nextLevelAlertSlot = 0;
   }

   m_levelAlertStates[idx].boxStart     = boxStart;
   m_levelAlertStates[idx].highAlerted  = false;
   m_levelAlertStates[idx].lowAlerted   = false;

   return idx;
}


// بررسی تماس کندل بسته‌شده با سقف و کف تمام باکس‌ها.
//
// قوانین هشدار:
// 1. در هر کندل حداکثر یک هشدار ثبت می‌شود.
// 2. اولین هشدار پذیرفته‌شده، شرط فاصله ندارد.
// 3. هشدارهای کندل‌های بعدی باید حداقل 10 پیپ
//    با آخرین هشدار پذیرفته‌شده فاصله داشته باشند.
// 4. تمام وضعیت‌های سطح‌ها همچنان به‌روز می‌شوند.
void CheckBoxLevelTouches(
   CFractalGeometry &fractal,
   bool allowAlerts,
   datetime candleTime
)
{
   int total = fractal.SmallBoxCount();

   if(total <= 0)
      return;

   if(total > MO_MAX_BOXES)
      total = MO_MAX_BOXES;

   double h = iHigh(_Symbol, PERIOD_H1, 1);
   double l = iLow(_Symbol, PERIOD_H1, 1);

   if(h == 0 || l == 0)
      return;

   // اولین تاچ جدیدی که در این کندل پیدا می‌شود.
   bool     candidateFound = false;
   string   candidateType  = "";
   datetime candidateBoxStart = 0;
   double   candidateLevel = 0.0;

   for(int i = 0; i < total; i++)
   {
      FlatZone box;

      if(!fractal.GetSmallBox(i, box))
         continue;

      int stateIndex =
         FindOrCreateLevelAlertState(box.startTime);

      // -------------------------
      // بررسی سقف باکس
      // -------------------------
      bool touchesHigh =
         (l <= box.highPrice && h >= box.highPrice);

      if(!touchesHigh)
      {
         // با فاصله گرفتن از سطح، هشدار بعدی آن سطح مجاز می‌شود.
         m_levelAlertStates[stateIndex].highAlerted = false;
      }
      else if(allowAlerts &&
              !m_levelAlertStates[stateIndex].highAlerted)
      {
         // فقط اولین تاچ جدید این کندل کاندید می‌شود.
         if(!candidateFound)
         {
            candidateFound    = true;
            candidateType     = "HIGH";
            candidateBoxStart = box.startTime;
            candidateLevel    = box.highPrice;
         }

         // سطح لمس‌شده ثبت‌شده محسوب می‌شود،
         // حتی اگر کاندید آن کندل بعداً به دلیل فاصله رد شود.
         m_levelAlertStates[stateIndex].highAlerted = true;
      }

      // -------------------------
      // بررسی کف باکس
      // -------------------------
      bool touchesLow =
         (l <= box.lowPrice && h >= box.lowPrice);

      if(!touchesLow)
      {
         m_levelAlertStates[stateIndex].lowAlerted = false;
      }
      else if(allowAlerts &&
              !m_levelAlertStates[stateIndex].lowAlerted)
      {
         if(!candidateFound)
         {
            candidateFound    = true;
            candidateType     = "LOW";
            candidateBoxStart = box.startTime;
            candidateLevel    = box.lowPrice;
         }

         m_levelAlertStates[stateIndex].lowAlerted = true;
      }
   }

   // اگر در این کندل تاچ جدیدی پیدا نشد، تمام.
   if(!candidateFound)
      return;

   // اندازه یک پیپ برای نمادهای 3 و 5 رقمی.
   double pipSize =
      ((_Digits == 3 || _Digits == 5)
       ? 10.0 * _Point
       : _Point);

   // اولین هشدار هیچ محدودیت فاصله‌ای ندارد.
   bool acceptAlert = !m_hasAcceptedTouchPrice;

   if(m_hasAcceptedTouchPrice)
   {
      double distancePips =
         MathAbs(candidateLevel - m_lastAcceptedTouchPrice)
         / pipSize;

      // هشدار جدید باید حداقل 10 پیپ فاصله داشته باشد.
      acceptAlert = (distancePips >= 10.0);
   }

   // فاصله کافی نیست؛ هشدار این کندل نادیده گرفته می‌شود.
   // قیمت آخرین هشدار پذیرفته‌شده تغییر نمی‌کند.
   if(!acceptAlert)
      return;

   // ثبت تنها هشدار این کندل.
   Print(
      "[MarketObserver] LEVEL TOUCH: ",
      candidateType,
      " BoxStart=",
      TimeToString(
         candidateBoxStart,
         TIME_DATE | TIME_MINUTES
      ),
      " Level=",
      DoubleToString(candidateLevel, _Digits),
      " Candle=",
      TimeToString(
         candleTime,
         TIME_DATE | TIME_MINUTES
      )
   );

   // مبنای مقایسه هشدارهای کندل‌های بعدی.
   m_lastAcceptedTouchPrice = candidateLevel;
   m_hasAcceptedTouchPrice  = true;
}



// بررسی کندل بسته‌شده و ثبت تغییر وضعیت
// بررسی کندل بسته‌شده در گروه زمانی همپوشان
void ObserveCandle(datetime candleTime)
{
   // بدون حداقل دو باکس، تحلیل انجام نمی‌شود.
   if(!m_zoneReady || m_zoneBoxCount < 2)
      return;

   double h = iHigh(_Symbol, PERIOD_H1, 1);
   double l = iLow(_Symbol, PERIOD_H1, 1);
   double c = iClose(_Symbol, PERIOD_H1, 1);

   if(h == 0 || l == 0 || c == 0)
      return;

   MARKET_VIEW nextView = MARKET_STUCK ;
   bool hasEvent = false;

   string reason = "";
   string uncertainty = "";

   // 1. بسته‌شدن بالای سقف گروه
   if(c > m_zoneHigh)
   {
      nextView = MARKET_BULLISH;
      hasEvent = true;

      reason = "کندل بالای سقف گروه زمانی بسته شد";
      uncertainty = "ادامه حرکت صعودی هنوز تأیید نشده است";
   }
   // 2. بسته‌شدن پایین کف گروه
   else if(c < m_zoneLow)
   {
      nextView = MARKET_BEARISH;
      hasEvent = true;

      reason = "کندل پایین کف گروه زمانی بسته شد";
      uncertainty = "ادامه حرکت نزولی هنوز تأیید نشده است";
   }
   // 3. عبور از سقف و بسته‌شدن داخل محدوده
   else if(h > m_zoneHigh)
   {
      nextView = MARKET_FROM_CEILING;
      hasEvent = true;

      reason = "قیمت از سقف عبور کرد اما داخل محدوده بسته شد";
      uncertainty = "حرکت بعدی هنوز مشخص نیست";
   }
   // 4. عبور از کف و بسته‌شدن داخل محدوده
   else if(l < m_zoneLow)
   {
      nextView = MARKET_FROM_FLOOR;
      hasEvent = true;

      reason = "قیمت از کف عبور کرد اما داخل محدوده بسته شد";
      uncertainty = "حرکت بعدی هنوز مشخص نیست";
   }

   // اگر هیچ‌یک از چهار رویداد رخ نداده باشد،
   // نظریه درجا زدن برقرار می‌ماند.
   // Close بالاتر یا پایین‌تر از کندل قبلی به‌تنهایی
   // رویداد جدیدی ایجاد نمی‌کند.
   if(!hasEvent)
      return;

   // فقط با وقوع یک رویداد جدید، وضعیت دفترچه را تغییر می‌دهیم.
   if(!m_notebook.HasView() ||
      nextView != m_notebook.View())
   {
      m_notebook.Revise(
         nextView,
         reason,
         uncertainty,
         candleTime
      );

      Print("[MarketObserver] ", m_notebook.Summary());
   }
}

   void CheckNewBox(CFractalGeometry &fractal)
   {
      FlatZone box;

      if(!fractal.GetSmallBox(0, box))
         return;

      if(box.startTime == m_lastBoxStart &&
         box.endTime == m_lastBoxEnd)
      {
         return;
      }

      m_lastBoxStart = box.startTime;
      m_lastBoxEnd   = box.endTime;



      if(!BuildOverLapZone(fractal))
         return;
      
      
      // وضعیت گروه جدید
      bool stuckTheory = (m_zoneBoxCount >= 2);
      
      
      // باکس جدید عمر نظریهٔ قبلی را تمام می‌کند.
      // اگر گروه جدید نشانهٔ درجا زدن باشد، این دلیل
      // بر پایان نظریه اولویت دارد.
      if(m_theoryActive)
      {
         if(stuckTheory)
         {
         
            // نظریه و محدوده مرجع آن را پیش از غیرفعال‌کردن حفظ کن.
            m_suspendedTheoryValid   = true;
            m_suspendedTheoryBullish = m_theoryBullish;
      
            m_suspendedReferenceHigh = m_theoryReferenceHigh;
            m_suspendedReferenceLow  = m_theoryReferenceLow;

      
            ExpireRandomTheory("STUCK_RESUMED", m_zoneEnd);
         }
         else
         {
            ExpireRandomTheory("NEW_BOX_ARRIVED", m_zoneEnd);
         }
      }

      
      
      // ثبت وضعیت نظریهٔ درجا زدن
      if(m_notebook.SetStuckTheory(stuckTheory, m_zoneEnd))
      {
         if(stuckTheory)
            Print("[MarketObserver] Theory: درجا می‌زنیم");
         else
            Print("[MarketObserver] Theory: درجا زدن غیرفعال شد");
      }
      
      
      // اگر وضعیت جدید درجا زدن نیست، نظریهٔ تازه
      // بلافاصله انتخاب می‌شود.
      if(!stuckTheory)
         SelectRandomTheory(m_zoneEnd);





      Print(
         "[MarketObserver] Shared OverLap group: ",
         m_zoneBoxCount,
         " boxes; High=",
         DoubleToString(m_zoneHigh, _Digits),
         " Low=",
         DoubleToString(m_zoneLow, _Digits),
         " Start=",
         TimeToString(m_zoneStart, TIME_DATE | TIME_MINUTES),
         " End=",
         TimeToString(m_zoneEnd, TIME_DATE | TIME_MINUTES)
      );
   }
