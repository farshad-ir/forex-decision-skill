#ifndef __BOX_RELATION_REVIEW_MQH__
#define __BOX_RELATION_REVIEW_MQH__

#include "FractalGeometry.mqh"

enum BOX_RELATION
{
   BOX_ABOVE,
   BOX_BELOW,
   BOX_EQUAL,
   BOX_OVERLAP,
   BOX_NEW_INSIDE_OLD,
   BOX_NEW_CONTAINS_OLD,
   BOX_TOUCH
};

class CBoxRelationReview
{
private:
   double Epsilon()
   {
      return _Point * 0.5;
   }

public:
   // newer = باکس جدیدتر
   // older = باکس قدیمی‌تر
   BOX_RELATION Compare(
      FlatZone &newer,
      FlatZone &older,
      double &overlap,
      double &overlapPercent
   )
   {
      double eps = Epsilon();

      double nh = newer.highPrice;
      double nl = newer.lowPrice;
      double oh = older.highPrice;
      double ol = older.lowPrice;

      double commonHigh = MathMin(nh, oh);
      double commonLow  = MathMax(nl, ol);

      overlap = MathMax(0.0, commonHigh - commonLow);

      double newRange = nh - nl;
      double oldRange = oh - ol;
      double minRange = MathMin(newRange, oldRange);

      overlapPercent = 0.0;

      if(minRange > eps && overlap > eps)
         overlapPercent = 100.0 * overlap / minRange;

      if(MathAbs(nh - oh) <= eps &&
         MathAbs(nl - ol) <= eps)
         return BOX_EQUAL;

      if(nl > oh + eps)
         return BOX_ABOVE;

      if(nh < ol - eps)
         return BOX_BELOW;

      if(MathAbs(nl - oh) <= eps ||
         MathAbs(nh - ol) <= eps)
         return BOX_TOUCH;

      if(nh <= oh + eps && nl >= ol - eps)
         return BOX_NEW_INSIDE_OLD;

      if(nh >= oh - eps && nl <= ol + eps)
         return BOX_NEW_CONTAINS_OLD;

      return BOX_OVERLAP;
   }

   string Name(BOX_RELATION relation)
   {
      switch(relation)
      {
         case BOX_ABOVE:           return "ABOVE";
         case BOX_BELOW:           return "BELOW";
         case BOX_EQUAL:           return "EQUAL";
         case BOX_OVERLAP:         return "OVERLAP";
         case BOX_NEW_INSIDE_OLD:  return "NEW_INSIDE_OLD";
         case BOX_NEW_CONTAINS_OLD:return "NEW_CONTAINS_OLD";
         case BOX_TOUCH:           return "TOUCH";
      }

      return "UNKNOWN";
   }
};

#endif





#ifndef __MARKET_OBSERVER_MQH__
#define __MARKET_OBSERVER_MQH__

#include "FractalGeometry.mqh"

#define MO_MAX_BOXES 1000

class CMarketObserver
{
private:
   CMarketNotebook m_notebook;

   double   m_zoneHigh;
   double   m_zoneLow;
   int      m_zoneBoxCount;
   datetime m_zoneStart;
   datetime m_zoneEnd;

   bool     m_zoneReady;
   datetime m_lastCandle;
   datetime m_lastBoxStart;
   datetime m_lastBoxEnd;

   double   m_lastClose;
   bool     m_hasLastClose;

   // ساخت محدوده مشترک باکس‌های متصل از نظر زمانی
   bool BuildSharedZone(CFractalGeometry &fractal)
   {
      int total = fractal.SmallBoxCount();

      if(total <= 0)
         return false;

      if(total > MO_MAX_BOXES)
         total = MO_MAX_BOXES;

      FlatZone box;

      // گروه با جدیدترین باکس آغاز می‌شود.
      if(!fractal.GetSmallBox(0, box))
         return false;

      m_zoneHigh     = box.highPrice;
      m_zoneLow      = box.lowPrice;
      m_zoneBoxCount = 1;
      m_zoneStart    = box.startTime;
      m_zoneEnd      = box.endTime;

      datetime groupStart = box.startTime;

      // باکس‌ها از جدیدترین به قدیمی‌ترین مرتب شده‌اند.
      for(int i = 1; i < total; i++)
      {
         if(!fractal.GetSmallBox(i, box))
            break;

         // پایان باکس قدیمی‌تر باید حداکثر یک کندل
         // با شروع گروه فاصله داشته باشد.
         if(box.endTime <
            groupStart - PeriodSeconds(PERIOD_H1))
         {
            break;
         }

         // این باکس به گروه زمانی متصل است.
         groupStart = box.startTime;

         m_zoneBoxCount++;

         if(box.startTime < m_zoneStart)
            m_zoneStart = box.startTime;

         if(box.endTime > m_zoneEnd)
            m_zoneEnd = box.endTime;

         // قیمت فقط برای محاسبه سقف و کف گروه استفاده می‌شود.
         if(box.highPrice > m_zoneHigh)
            m_zoneHigh = box.highPrice;

         if(box.lowPrice < m_zoneLow)
            m_zoneLow = box.lowPrice;
      }

      m_zoneReady = true;

      return true;
   }

   // بررسی کندل بسته‌شده و ثبت تغییر وضعیت
   void ObserveCandle(datetime candleTime)
   {
      if(!m_zoneReady)
         return;

      double h = iHigh(_Symbol, PERIOD_H1, 1);
      double l = iLow(_Symbol, PERIOD_H1, 1);
      double c = iClose(_Symbol, PERIOD_H1, 1);

      if(h == 0 || l == 0 || c == 0)
         return;

      MARKET_VIEW nextView = m_notebook.View();

      string reason = m_notebook.Reason();
      string uncertainty = m_notebook.Uncertainty();

      // بسته‌شدن بیرون سقف
      if(c > m_zoneHigh)
      {
         nextView = MARKET_BULLISH;
         reason = "کندل بالای سقف گروه زمانی بسته شد";
         uncertainty = "ادامه حرکت صعودی هنوز تأیید نشده است";
      }
      // بسته‌شدن بیرون کف
      else if(c < m_zoneLow)
      {
         nextView = MARKET_BEARISH;
         reason = "کندل پایین کف گروه زمانی بسته شد";
         uncertainty = "ادامه حرکت نزولی هنوز تأیید نشده است";
      }
      // نفوذ از سقف و بسته‌شدن داخل محدوده
      else if(h > m_zoneHigh)
      {
         nextView = MARKET_FROM_CEILING;
         reason = "قیمت از سقف عبور کرد اما داخل محدوده بسته شد";
         uncertainty = "ادامه حرکت بعدی هنوز مشخص نیست";
      }
      // نفوذ از کف و بسته‌شدن داخل محدوده
      else if(l < m_zoneLow)
      {
         nextView = MARKET_FROM_FLOOR;
         reason = "قیمت از کف عبور کرد اما داخل محدوده بسته شد";
         uncertainty = "ادامه حرکت بعدی هنوز مشخص نیست";
      }
      // حرکت داخل محدوده بر اساس مقایسه دو بسته‌شدن
      else if(m_hasLastClose && c > m_lastClose)
      {
         nextView = MARKET_BULLISH;
         reason = "بسته‌شدن کندل بالاتر از بسته‌شدن قبلی است";
         uncertainty = "قیمت هنوز داخل محدوده مشترک قرار دارد";
      }
      else if(m_hasLastClose && c < m_lastClose)
      {
         nextView = MARKET_BEARISH;
         reason = "بسته‌شدن کندل پایین‌تر از بسته‌شدن قبلی است";
         uncertainty = "قیمت هنوز داخل محدوده مشترک قرار دارد";
      }
      else
      {
         nextView = MARKET_STUCK;
         reason = "بسته‌شدن قیمت تغییر معناداری نسبت به کندل قبلی ندارد";
         uncertainty = "جهت بعدی هنوز مشخص نیست";
      }

      // فقط هنگام تغییر وضعیت، دفترچه را به‌روز می‌کنیم.
      if(nextView != m_notebook.View())
      {
         m_notebook.Revise(
            nextView,
            reason,
            uncertainty,
            candleTime
         );

         Print("[MarketObserver] ", m_notebook.Summary());
      }

      m_lastClose = c;
      m_hasLastClose = true;
   }

   void CheckNewBox(CFractalGeometry &fractal)
   {
      FlatZone box;

      if(!fractal.GetSmallBox(0, box))
         return;

      if(box.startTime == m_lastBoxStart &&
         box.endTime == m_lastBoxEnd)
      {
         return;
      }

      m_lastBoxStart = box.startTime;
      m_lastBoxEnd   = box.endTime;

      if(!BuildSharedZone(fractal))
         return;

      Print(
         "[MarketObserver] Shared time group: ",
         m_zoneBoxCount,
         " boxes; High=",
         DoubleToString(m_zoneHigh, _Digits),
         " Low=",
         DoubleToString(m_zoneLow, _Digits),
         " Start=",
         TimeToString(m_zoneStart, TIME_DATE | TIME_MINUTES),
         " End=",
         TimeToString(m_zoneEnd, TIME_DATE | TIME_MINUTES)
      );
   }

public:
   CMarketObserver()
   {
      m_zoneHigh      = 0;
      m_zoneLow       = 0;
      m_zoneBoxCount  = 0;
      m_zoneStart     = 0;
      m_zoneEnd       = 0;

      m_zoneReady     = false;
      m_lastCandle    = 0;
      m_lastBoxStart  = 0;
      m_lastBoxEnd    = 0;

      m_lastClose     = 0;
      m_hasLastClose  = false;
   }

   void Init(CFractalGeometry &fractal)
   {
      CheckNewBox(fractal);
   }

   // newCandle و newBoxArrived را فراخواننده تعیین می‌کند.
   void Update(
      CFractalGeometry &fractal,
      bool newCandle,
      bool newBoxArrived
   )
   {
      if(newBoxArrived)
         CheckNewBox(fractal);

      if(!newCandle)
         return;

      datetime t = iTime(_Symbol, PERIOD_H1, 1);

      if(t == 0 || t == m_lastCandle)
         return;

      m_lastCandle = t;

      ObserveCandle(t);
   }

   MARKET_VIEW View()
   {
      return m_notebook.View();
   }

   string Summary()
   {
      return m_notebook.Summary();
   }

   double ZoneHigh()
   {
      return m_zoneHigh;
   }

   double ZoneLow()
   {
      return m_zoneLow;
   }

   int ZoneBoxCount()
   {
      return m_zoneBoxCount;
   }
};

#endif
