#ifndef __BOX_HISTORY_REVIEW_MQH__
#define __BOX_HISTORY_REVIEW_MQH__

#include "FractalGeometry.mqh"

#define REVIEW_MAX_BOXES   20

struct ReviewCandle
{
   datetime time;
   double   high;
   double   low;
   double   close;
};

class CBoxHistoryReview
{
private:
   FlatZone    m_boxes[REVIEW_MAX_BOXES];

   int m_boxCount;
   int m_candleCount;
   int idx;

public:
   CBoxHistoryReview()
   {
      m_boxCount    = 0;
      m_candleCount = 0;
   }

   void LoadBoxes(CFractalGeometry &fractal)
   {
      int total = fractal.SmallBoxCount();

      m_boxCount = MathMin(total, REVIEW_MAX_BOXES);

      for(int i = 0; i < m_boxCount; i++)
      {
         fractal.GetSmallBox(i, m_boxes[i]);
      }

      Print("Review boxes loaded: ", m_boxCount);
   }

   void CandleRev()
   {
      int b = m_boxCount - 1 ;
      datetime t0 = m_boxes[b].startTime;
      idx = iBarShift(_Symbol,PERIOD_H1, t0);

      Print("Oldest box start: ",
            TimeToString(t0, TIME_DATE | TIME_MINUTES));

      Print("History starts at shift: ", idx,
         " time: ",
         TimeToString(iTime(_Symbol, PERIOD_H1, idx),
                   TIME_DATE | TIME_MINUTES));      
      
      
   }   

   void Match()
   {
      for(int c = idx; c > 3 ; c--)
      {
         for(int b = m_boxCount - 1 ; b >= 0; b--)
         {
            FlatZone box = m_boxes[b];
            datetime candleTime = iTime(_Symbol, PERIOD_H1, c );
            
            if(  candleTime < box.startTime ||
                 candleTime > box.endTime)
            {
               continue;
            }

            Print(
               "Candle=", TimeToString(candleTime),
               " Box=", TimeToString(
                  box.endTime, TIME_DATE | TIME_MINUTES),
               " H=", DoubleToString(iHigh  (_Symbol, PERIOD_H1, c ), _Digits),
               " L=", DoubleToString(iLow   (_Symbol, PERIOD_H1, c ), _Digits),
               " C=", DoubleToString(iClose (_Symbol, PERIOD_H1, c ), _Digits)
            );
         }
      }
   }
};

#endif







#ifndef __BOX_BREAKOUT_MACHINE_MQH__
#define __BOX_BREAKOUT_MACHINE_MQH__

#include "FractalGeometry.mqh"

enum BOX_EVENT
{
   BOX_EVENT_NONE = 0,
   BOX_EVENT_UPPER_PENETRATION,
   BOX_EVENT_LOWER_PENETRATION,
   BOX_EVENT_UPPER_BREAKOUT,
   BOX_EVENT_LOWER_BREAKOUT,
   BOX_EVENT_CLOSE_INSIDE
};

enum BoxMachineState
{
   BOX_MACHINE_OFF = 0,
   BOX_MACHINE_INSIDE,
   BOX_MACHINE_UPPER_TEST,
   BOX_MACHINE_LOWER_TEST,
   BOX_MACHINE_UPPER_BREAKOUT,
   BOX_MACHINE_LOWER_BREAKOUT
};

class CBoxBreakoutMachine
{
private:
   FlatZone        m_box;
   BoxMachineState m_state;
   bool            m_active;
   datetime        m_lastCandleTime;

public:
   CBoxBreakoutMachine()
   {
      m_state          = BOX_MACHINE_OFF;
      m_active          = false;
      m_lastCandleTime  = 0;
   }

   void Start(FlatZone &box)
   {
      m_box             = box;
      m_state           = BOX_MACHINE_INSIDE;
      m_active          = true;
      m_lastCandleTime  = 0;
   }

   bool IsActive()
   {
      return m_active;
   }

   BoxMachineState State()
   {
      return m_state;
   }

   datetime BoxEndTime()
   {
      return m_box.endTime;
   }

   // فقط رویداد جدید را برمی‌گرداند.
   // shift=1 یعنی آخرین کندل بسته‌شده.
   BOX_EVENT Feed(int shift)
   {
      if(!m_active)
         return BOX_EVENT_NONE;

      datetime t = iTime(_Symbol, PERIOD_CURRENT, shift);

      if(t == 0 || t == m_lastCandleTime)
         return BOX_EVENT_NONE;

      m_lastCandleTime = t;

      double h = iHigh(_Symbol, PERIOD_CURRENT, shift);
      double l = iLow(_Symbol, PERIOD_CURRENT, shift);
      double c = iClose(_Symbol, PERIOD_CURRENT, shift);

      BoxMachineState oldState = m_state;

      // بسته‌شدن بیرون محدوده، بر نفوذ اولویت دارد.
      if(c > m_box.highPrice)
      {
         m_state = BOX_MACHINE_UPPER_BREAKOUT;

         if(oldState != m_state)
            return BOX_EVENT_UPPER_BREAKOUT;

         return BOX_EVENT_NONE;
      }

      if(c < m_box.lowPrice)
      {
         m_state = BOX_MACHINE_LOWER_BREAKOUT;

         if(oldState != m_state)
            return BOX_EVENT_LOWER_BREAKOUT;

         return BOX_EVENT_NONE;
      }

      // قیمت داخل محدوده بسته شده است.
      if(h > m_box.highPrice)
      {
         m_state = BOX_MACHINE_UPPER_TEST;

         if(oldState != m_state)
            return BOX_EVENT_UPPER_PENETRATION;

         return BOX_EVENT_NONE;
      }

      if(l < m_box.lowPrice)
      {
         m_state = BOX_MACHINE_LOWER_TEST;

         if(oldState != m_state)
            return BOX_EVENT_LOWER_PENETRATION;

         return BOX_EVENT_NONE;
      }

      // قیمت کاملاً درون باکس مانده است.
      m_state = BOX_MACHINE_INSIDE;

      if(oldState != BOX_MACHINE_INSIDE)
         return BOX_EVENT_CLOSE_INSIDE;

      return BOX_EVENT_NONE;
   }
};

#endif


#ifndef __MARKET_NOTEBOOK_MQH__
#define __MARKET_NOTEBOOK_MQH__

enum MARKET_VIEW
{
   MARKET_BEARISH = -1,
   MARKET_PULLBACK_OR_TURN = 0,
   MARKET_BULLISH = 1
};

class CMarketNotebook
{
private:
   MARKET_VIEW m_view;
   string      m_reason;
   string      m_uncertainty;
   datetime    m_updated;

public:
   CMarketNotebook()
   {
      m_view        = MARKET_PULLBACK_OR_TURN;
      m_reason      = "هنوز شواهد کافی نداریم";
      m_uncertainty = "جهت بازار مشخص نشده است";
      m_updated     = 0;
   }

   void Revise(
      MARKET_VIEW view,
      string reason,
      string uncertainty,
      datetime when
   )
   {
      m_view        = view;
      m_reason      = reason;
      m_uncertainty = uncertainty;
      m_updated     = when;
   }

   MARKET_VIEW View()
   {
      return m_view;
   }

   string Reason()
   {
      return m_reason;
   }

   string Uncertainty()
   {
      return m_uncertainty;
   }

   datetime UpdatedAt()
   {
      return m_updated;
   }

   string Summary()
   {
      string state = "پول‌بک یا چرخش";

      if(m_view == MARKET_BEARISH)
         state = "نزولی هستیم";
      else if(m_view == MARKET_BULLISH)
         state = "صعودی هستیم";

      return "وضعیت: " + state
         + "\nدلیل: " + m_reason
         + "\nعامل تردید: " + m_uncertainty
         + "\nزمان: "
         + TimeToString(m_updated, TIME_DATE | TIME_MINUTES);
   }
};

#endif




#ifndef __BOX_RELATION_REVIEW_MQH__
#define __BOX_RELATION_REVIEW_MQH__

#include "FractalGeometry.mqh"

enum BOX_RELATION
{
   BOX_ABOVE,
   BOX_BELOW,
   BOX_EQUAL,
   BOX_OVERLAP,
   BOX_NEW_INSIDE_OLD,
   BOX_NEW_CONTAINS_OLD,
   BOX_TOUCH
};

class CBoxRelationReview
{
private:
   double Epsilon()
   {
      return _Point * 0.5;
   }

public:
   // newer = باکس جدیدتر
   // older = باکس قدیمی‌تر
   BOX_RELATION Compare(
      FlatZone &newer,
      FlatZone &older,
      double &overlap,
      double &overlapPercent
   )
   {
      double eps = Epsilon();

      double nh = newer.highPrice;
      double nl = newer.lowPrice;
      double oh = older.highPrice;
      double ol = older.lowPrice;

      double commonHigh = MathMin(nh, oh);
      double commonLow  = MathMax(nl, ol);

      overlap = MathMax(0.0, commonHigh - commonLow);

      double newRange = nh - nl;
      double oldRange = oh - ol;
      double minRange = MathMin(newRange, oldRange);

      overlapPercent = 0.0;

      if(minRange > eps && overlap > eps)
         overlapPercent = 100.0 * overlap / minRange;

      if(MathAbs(nh - oh) <= eps &&
         MathAbs(nl - ol) <= eps)
         return BOX_EQUAL;

      if(nl > oh + eps)
         return BOX_ABOVE;

      if(nh < ol - eps)
         return BOX_BELOW;

      if(MathAbs(nl - oh) <= eps ||
         MathAbs(nh - ol) <= eps)
         return BOX_TOUCH;

      if(nh <= oh + eps && nl >= ol - eps)
         return BOX_NEW_INSIDE_OLD;

      if(nh >= oh - eps && nl <= ol + eps)
         return BOX_NEW_CONTAINS_OLD;

      return BOX_OVERLAP;
   }

   string Name(BOX_RELATION relation)
   {
      switch(relation)
      {
         case BOX_ABOVE:           return "ABOVE";
         case BOX_BELOW:           return "BELOW";
         case BOX_EQUAL:           return "EQUAL";
         case BOX_OVERLAP:         return "OVERLAP";
         case BOX_NEW_INSIDE_OLD:  return "NEW_INSIDE_OLD";
         case BOX_NEW_CONTAINS_OLD:return "NEW_CONTAINS_OLD";
         case BOX_TOUCH:           return "TOUCH";
      }

      return "UNKNOWN";
   }
};

#endif





#ifndef __MARKET_OBSERVER_MQH__
#define __MARKET_OBSERVER_MQH__

#include "FractalGeometry.mqh"
#include "BoxBreakoutMachine.mqh"


#define MO_MAX_MACHINES 20

class CMarketObserver
{
private:
   CBoxBreakoutMachine m_machines[MO_MAX_MACHINES];
   int                 m_machineCount;

   CBoxRelationReview  m_relations;
   CMarketNotebook     m_notebook;

   datetime m_lastCandle;
   datetime m_lastBoxStart;
   datetime m_lastBoxEnd;

   string RelationEvidence(
      CFractalGeometry &fractal,
      FlatZone &newBox
   )
   {
      FlatZone oldBox;

      if(!fractal.GetSmallBox(1, oldBox))
         return "باکس قبلی برای مقایسه موجود نیست";

      double overlap = 0.0;
      double overlapPercent = 0.0;

      BOX_RELATION r = m_relations.Compare(
         newBox, oldBox, overlap, overlapPercent
      );

      return "رابطه باکس جدید با قبلی: "
         + m_relations.Name(r)
         + "؛ هم‌پوشانی="
         + DoubleToString(overlapPercent, 1) + "%";
   }

   void AddNewBox(CFractalGeometry &fractal)
   {
      FlatZone box;

      if(!fractal.GetSmallBox(0, box))
         return;

      if(box.startTime == m_lastBoxStart &&
         box.endTime == m_lastBoxEnd)
         return;

      if(m_machineCount >= MO_MAX_MACHINES)
      {
         Print("[MarketObserver] Machine limit reached.");
         return;
      }

      string relation = RelationEvidence(fractal, box);

      m_machines[m_machineCount].Start(box);
      m_machineCount++;

      m_lastBoxStart = box.startTime;
      m_lastBoxEnd   = box.endTime;

      //Print("[MarketObserver] ", relation);
      m_notebook.Revise(
         m_notebook.View(),
         m_notebook.Reason(),
         relation,
         TimeCurrent()
      );
   }

   void ApplyEvents(datetime candleTime)
   {
      bool bullish = false;
      bool bearish = false;
      bool uncertain = false;

      string bullReason = "";
      string bearReason = "";
      string uncertainReason = "";

      for(int i = 0; i < m_machineCount; i++)
      {
         BOX_EVENT e = m_machines[i].Feed(1);

         switch(e)
         {
            case BOX_EVENT_UPPER_BREAKOUT:
               bullish = true;
               bullReason = "بسته‌شدن قیمت بالای سقف یک باکس";
               break;

            case BOX_EVENT_LOWER_BREAKOUT:
               bearish = true;
               bearReason = "بسته‌شدن قیمت پایین کف یک باکس";
               break;

            case BOX_EVENT_UPPER_PENETRATION:
               uncertain = true;
               uncertainReason =
                  "نفوذ به سقف باکس بدون بسته‌شدن بالای آن";
               break;

            case BOX_EVENT_LOWER_PENETRATION:
               uncertain = true;
               uncertainReason =
                  "نفوذ به کف باکس بدون بسته‌شدن پایین آن";
               break;

            case BOX_EVENT_CLOSE_INSIDE:
               uncertain = true;
               uncertainReason =
                  "قیمت پس از خروج یا آزمون به داخل باکس برگشته است";
               break;

            default:
               break;
         }
      }

      // شواهد مخالف هم‌زمان: نتیجهٔ جهت‌دار صادر نمی‌کنیم.
      if(bullish && bearish)
      {
         m_notebook.Revise(
            MARKET_PULLBACK_OR_TURN,
            "باکس‌های مختلف شواهد شکست مخالف داده‌اند",
            "جهت بازار تا روشن‌شدن تعارض مشخص نیست",
            candleTime
         );
      }
      else if(bullish)
      {
         m_notebook.Revise(
            MARKET_BULLISH,
            bullReason,
            "شکست یک باکس به‌تنهایی اثبات‌کنندهٔ روند صعودی نیست",
            candleTime
         );
      }
      else if(bearish)
      {
         m_notebook.Revise(
            MARKET_BEARISH,
            bearReason,
            "شکست یک باکس به‌تنهایی اثبات‌کنندهٔ روند نزولی نیست",
            candleTime
         );
      }
      else if(uncertain)
      {
         m_notebook.Revise(
            MARKET_PULLBACK_OR_TURN,
            uncertainReason,
            "برای تشخیص پول‌بک از چرخش، ساختار قبلی نیز باید بررسی شود",
            candleTime
         );
      }
   }

public:
   CMarketObserver()
   {
      m_machineCount = 0;
      m_lastCandle   = 0;
      m_lastBoxStart = 0;
      m_lastBoxEnd   = 0;
   }

   void Init(CFractalGeometry &fractal)
   {
      AddNewBox(fractal);
   }

   // newBoxArrived را خود اکسپرت با پولینگ تعیین می‌کند.
   void Update(
      CFractalGeometry &fractal,
      bool newCandle,
      bool newBoxArrived
   )
   {
      if(newBoxArrived)
         AddNewBox(fractal);

      if(!newCandle)
         return;

      datetime t = iTime(_Symbol, PERIOD_CURRENT, 1);

      if(t == 0 || t == m_lastCandle)
         return;

      m_lastCandle = t;

      ApplyEvents(t);
   }

   MARKET_VIEW View()
   {
      return m_notebook.View();
   }

   string Summary()
   {
      return m_notebook.Summary();
   }
};

#endif

